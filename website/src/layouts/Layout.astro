---
import '../styles/global.css';
import { ui, links, localePath } from '../i18n/ui.js';

interface Props {
  lang?: 'en' | 'es';
  title?: string;
  description?: string;
  /** Path of this page without the language prefix, e.g. '/', '/how-it-works', '/docs'. */
  route?: string;
}

const { lang = 'en', route = '/' } = Astro.props;
const t = ui[lang];
const isEs = lang === 'es';
const title = Astro.props.title ?? t['meta.home.title'];
const description = Astro.props.description ?? t['meta.home.desc'];

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://clckernel.carlosleoncode.com';
const enPath = route;
const esPath = route === '/' ? '/es' : `/es${route}`;
const enURL = new URL(enPath, siteUrl).toString();
const esURL = new URL(esPath, siteUrl).toString();
const canonicalURL = isEs ? esURL : enURL;
const ogImage = `${siteUrl}/images/brand/og.jpg`;

const home = localePath(lang, '/');
const how = localePath(lang, '/how-it-works');
const docs = localePath(lang, '/docs');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'CLC Kernel',
  operatingSystem: 'macOS, Linux (Node.js 18+)',
  applicationCategory: 'DeveloperApplication',
  url: siteUrl,
  description,
  license: 'https://opensource.org/licenses/MIT',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Carlos León', url: 'https://www.carlosleoncode.com' },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0e0e0c" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/images/brand/favicon-64.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="es" href={esURL} />
    <link rel="alternate" hreflang="x-default" href={enURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="CLC Kernel" />
    <meta property="og:locale" content={isEs ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={isEs ? 'en_US' : 'es_ES'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={isEs ? 'Logo de CLC Kernel: un león con sudadera negra frente a un portátil, junto a la palabra clckernel.' : 'CLC Kernel logo: a lion in a black hoodie at a laptop, next to the word clckernel.'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" />

    <!-- Motion gate: content is visible by default; .js only arms the entrance, with a timed fallback. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        setTimeout(function () { if (!d.classList.contains('motion-ok')) d.classList.remove('js'); }, 2500);
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only-focusable mono-label fixed top-2 left-2 z-[60] bg-accent text-ink px-3 py-2">{t['skip']}</a>

    <header class="band-ink sticky top-0 z-50 border-b rule-ink" id="site-header">
      <div class="wrap flex items-center justify-between gap-3 h-16">
        <a href={home} class="flex items-center gap-2.5 shrink-0 min-h-[44px]" aria-label={t['nav.home']}>
          <img src="/images/brand/favicon-64.png" width="28" height="28" alt="" decoding="async" class="brand-mark" />
          <span class="font-semibold tracking-[-0.02em] text-[1.0625rem]">CLC Kernel</span>
        </a>

        <nav aria-label={isEs ? 'Principal' : 'Main'} class="flex items-center gap-3 sm:gap-6 min-w-0">
          <a href={how} class="mono-label nav-link inline-flex" aria-current={route === '/how-it-works' ? 'page' : undefined}>{t['nav.how']}</a>
          <a href={docs} class="mono-label nav-link hidden sm:inline-flex" aria-current={route === '/docs' ? 'page' : undefined}>{t['nav.docs']}</a>
          <a href={links.github} class="mono-label nav-link hidden min-[400px]:inline-flex" rel="noopener noreferrer" aria-label={`${t['nav.github']} (${isEs ? 'abre otro sitio' : 'opens another site'})`}>
            <svg class="sm:hidden" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.48 2 2 6.48 2 12.02c0 4.42 2.87 8.17 6.84 9.5.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.56 9.56 0 0 1 12 6.84c.85 0 1.7.11 2.5.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.7-4.57 4.94.36.31.68.92.68 1.86v2.75c0 .27.18.58.69.48A10.02 10.02 0 0 0 22 12.02C22 6.48 17.52 2 12 2Z"/></svg>
            <span class="hidden sm:inline">GitHub</span>
          </a>
          <div class="mono-label flex items-center border rule-ink rounded-md overflow-hidden" role="group" aria-label={t['nav.lang']}>
            <a href={enPath} hreflang="en" lang="en" class:list={['lang-link', { 'is-active': !isEs }]} aria-current={!isEs ? 'true' : undefined}>EN</a>
            <a href={esPath} hreflang="es" lang="es" class:list={['lang-link', { 'is-active': isEs }]} aria-current={isEs ? 'true' : undefined}>ES</a>
          </div>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="band-ink border-t rule-ink">
      <div class="wrap py-16 md:py-20 grid gap-12 md:grid-cols-12">
        <div class="md:col-span-6 space-y-4">
          <p class="font-semibold text-xl tracking-[-0.02em]">CLC Kernel</p>
          <p class="text-fog max-w-sm">{t['footer.tagline']}</p>
        </div>
        <div class="md:col-span-3">
          <p class="mono-label text-fog mb-4">{t['footer.product']}</p>
          <ul class="space-y-1">
            <li><a class="footer-link" href={how}>{t['nav.how']}</a></li>
            <li><a class="footer-link" href={docs}>{t['nav.docs']}</a></li>
            <li><a class="footer-link" href={links.npm} rel="noopener noreferrer">npm</a></li>
          </ul>
        </div>
        <div class="md:col-span-3">
          <p class="mono-label text-fog mb-4">{t['footer.project']}</p>
          <ul class="space-y-1">
            <li><a class="footer-link" href={links.github} rel="noopener noreferrer">GitHub</a></li>
            <li><a class="footer-link" href={links.license} rel="noopener noreferrer">{t['footer.license']}</a></li>
            <li><a class="footer-link" href={links.issues} rel="noopener noreferrer">Issues</a></li>
          </ul>
        </div>
        <div class="md:col-span-12 pt-8 border-t rule-ink flex flex-col sm:flex-row justify-between gap-3 mono-label text-fog">
          <span>MIT · © {new Date().getFullYear()} · {t['footer.by']} <a class="underline hover:text-paper" href="https://www.carlosleoncode.com" rel="noopener noreferrer">CarlosLeonCode</a></span>
          <span>npx clckernel . --yes</span>
        </div>
      </div>
    </footer>

    <style>
      .nav-link {
        align-items: center;
        min-height: 44px;
        white-space: nowrap;
        color: var(--color-fog);
        transition: color 150ms var(--ease-out);
      }
      .nav-link:hover, .nav-link[aria-current='page'] { color: var(--color-paper); }
      .nav-link[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--color-accent); text-decoration-thickness: 2px; }
      .lang-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 36px;
        min-height: 36px;
        color: var(--color-fog);
        transition: color 150ms var(--ease-out), background-color 150ms var(--ease-out);
      }
      .lang-link:hover { color: var(--color-paper); }
      .lang-link.is-active { background: var(--color-paper); color: var(--color-ink); }
      .footer-link {
        display: inline-flex;
        align-items: center;
        min-height: 40px;
        color: var(--color-paper);
        text-decoration: underline;
        text-decoration-color: transparent;
        transition: text-decoration-color 150ms var(--ease-out);
      }
      .footer-link:hover { text-decoration-color: var(--color-accent); }
      .brand-mark { width: 28px; height: 28px; border-radius: 7px; flex: none; }
      #main:focus { outline: none; }
    </style>

    <script>
      import '../scripts/copy.js';
    </script>
  </body>
</html>
