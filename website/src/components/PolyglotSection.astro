---
import { ui } from '../i18n/ui.js';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const t = ui[lang];
const isEs = lang === 'es';

const stacks = isEs ? [
  {
    id: "nextjs",
    name: "Next.js / React",
    lang: "TypeScript",
    icon: "⚡",
    detection: "package.json (next)",
    runner: "npm test (Vitest / Jest)",
    gate: "node tools/audit.js",
    rules: "Clean Arch + Responsive Guard + SEO & CWV",
    snippet: `// Detected: Next.js App Router (TypeScript)
// Initialized: .cursorrules, CLAUDE.md, AGY rules
// Audit Engine: Node.js pattern-based guards
✔ Hook instalado: .githooks/pre-commit (.husky/pre-commit si Husky ya ejecuta los hooks)
  -> node tools/audit.js --hook: scan_secrets, check_a11y, check_responsive, check_seo,
     check_ui_reuse, check_architecture, check_performance,
     verify_tdd, check_custom + tools/guards/
✔ Luego, si están disponibles: npx tsc --noEmit, npx lint-staged
✔ Enforcing: Mobile-first CSS & Clean Layer Isolation`,
  },
  {
    id: "fastapi",
    name: "FastAPI",
    lang: "Python",
    icon: "🐍",
    detection: "pyproject.toml / requirements.txt",
    runner: "pytest -v --cov",
    gate: "python tools/audit.py",
    rules: "Clean Arch (Python AST) + N+1 Heuristic + Secret Leak",
    snippet: `# Detected: FastAPI Backend (Python 3.11+)
# Initialized: GEMINI.md, CLAUDE.md, .cursorrules
# Audit Engine: Python Native ast Module
✔ Hook instalado: .githooks/pre-commit
  -> python3 tools/audit.py --hook: scan_secrets, check_architecture, check_db_efficiency,
     check_migrations, verify_tdd, check_custom + tools/guards/
✔ Luego, si están disponibles: python3 -m ruff check ., python3 -m pytest
✔ Enforcing: Red→Green TDD Verifier & N+1 Heuristic`,
  },
  {
    id: "django",
    name: "Django",
    lang: "Python",
    icon: "🎯",
    detection: "manage.py / settings.py",
    runner: "python manage.py test",
    gate: "python tools/audit.py",
    rules: "Clean Arch (Python AST) + N+1 Heuristic",
    snippet: `# Detected: Django Enterprise Stack
# Initialized: CLAUDE.md, .antigravity/rules.md
# Audit Engine: Python Native ast Module
✔ Hook instalado: .githooks/pre-commit
  -> python3 tools/audit.py --hook: scan_secrets, check_architecture, check_db_efficiency,
