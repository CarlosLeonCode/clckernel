<section id="ecosystems" class="relative py-20 md:py-28 border-t border-slate-200/80 bg-transparent overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-mono font-medium shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>{t['polyglot.kicker']}</span>
      </div>
      
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-[1.12]">
        {t['polyglot.title']}
      </h2>
      
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
        {t['polyglot.desc']}
      </p>
    </div>

    <!-- Organic Layout: Interactive Polyglot Stack Inspector -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-14 items-start">
      
      <!-- Stacks Tab List (Left Column: Sleek minimal pill items) -->
      <div class="lg:col-span-5 grid grid-cols-2 gap-2" id="polyglot-stack-list">
        {stacks.map((stack, idx) => (
          <button
            type="button"
            data-stack-id={stack.id}
            class={`polyglot-tab p-3 rounded-xl border text-left transition-all duration-150 cursor-pointer focus:outline-none flex items-center justify-between gap-2 group ${
              idx === 0
                ? 'active bg-white border-emerald-500/80 shadow-xs ring-1 ring-emerald-500/20'
                : 'bg-white/60 border-slate-200/80 hover:bg-white hover:border-slate-300'
            }`}
          >
            <div class="flex items-center gap-2 truncate">
              <span class="text-base">{stack.icon}</span>
              <span class="text-xs font-bold text-slate-900 group-hover:text-emerald-700 transition-colors truncate">
                {stack.name}
              </span>
            </div>
            <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 font-semibold shrink-0">
              {stack.lang}
            </span>
          </button>
        ))}
      </div>

      <!-- Live Stack Preview Card (Right Column) -->
      <div class="lg:col-span-7 bg-white text-slate-900 rounded-2xl border border-slate-200 shadow-lg shadow-slate-200/40 p-5 sm:p-6 relative overflow-hidden flex flex-col justify-between min-h-[340px]">
        
        <!-- Terminal Header -->
        <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-3">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
            <span class="ml-2 font-mono text-xs text-slate-600 font-semibold" id="preview-filename">.clckernel.yaml — nextjs</span>
          </div>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 font-mono text-[10px] font-semibold">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
            READY TO PROVISION
          </span>
        </div>

        <!-- Meta Specs Row -->
        <div class="grid grid-cols-3 gap-2 mb-3 font-mono text-xs">
          <div class="p-2 rounded-lg bg-slate-50 border border-slate-200/70">
            <span class="text-[9px] text-slate-400 block font-bold uppercase">SIGNATURE</span>
            <span class="text-slate-800 font-semibold truncate block text-[11px]" id="preview-detection">{stacks[0].detection}</span>
          </div>
          <div class="p-2 rounded-lg bg-slate-50 border border-slate-200/70">
            <span class="text-[9px] text-slate-400 block font-bold uppercase">TEST RUNNER</span>
            <span class="text-emerald-700 font-semibold truncate block text-[11px]" id="preview-runner">{stacks[0].runner}</span>
          </div>
          <div class="p-2 rounded-lg bg-slate-50 border border-slate-200/70">
            <span class="text-[9px] text-slate-400 block font-bold uppercase">AUDIT GATE</span>
            <span class="text-cyan-700 font-semibold truncate block text-[11px]" id="preview-gate">{stacks[0].gate}</span>
          </div>
        </div>

        <!-- Terminal Output Code Snippet -->
        <div class="bg-slate-50 rounded-xl p-3 font-mono text-[11px] text-slate-800 border border-slate-200 shadow-inner flex-1 flex flex-col justify-center">
          <pre class="whitespace-pre overflow-x-auto leading-relaxed text-slate-700" id="preview-snippet">{stacks[0].snippet}</pre>
        </div>

      </div>

    </div>

    <!-- AI Harness Integration: Borderless Horizontal Ribbon (No Cards) -->
    <div class="pt-4 border-t border-slate-200">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-xs font-mono uppercase text-slate-500 font-bold tracking-wider">
          {t['polyglot.harnessTitle']}
        </h3>
        <span class="text-[11px] font-mono text-emerald-700 font-semibold">
          {isEs ? "Sincronización Dinámica SSOT" : "SSOT Dynamic Sync"}
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {harnesses.map((harness) => (
          <div class="p-3.5 rounded-xl bg-white border border-slate-200/80 space-y-1.5 hover:border-emerald-300 hover:bg-emerald-50/20 transition-all duration-150 group">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2 font-bold text-xs text-slate-900 group-hover:text-emerald-800 transition-colors">
                <span class="text-sm">{harness.icon}</span>
                <span>{harness.name}</span>
              </div>
              <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 font-semibold">
                {harness.file}
              </span>
            </div>
            <p class="text-[11px] text-slate-600 leading-relaxed font-normal">
              {harness.desc}
            </p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<div id="polyglot-stacks-data" data-payload={JSON.stringify(stacks)} class="hidden"></div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const rawStacks = document.getElementById('polyglot-stacks-data')?.getAttribute('data-payload') || '[]';
    const stacksData = JSON.parse(rawStacks);
    if (!stacksData.length) return;

    const tabs = document.querySelectorAll('.polyglot-tab');
    const filenameEl = document.getElementById('preview-filename');
    const detectionEl = document.getElementById('preview-detection');
    const runnerEl = document.getElementById('preview-runner');
    const gateEl = document.getElementById('preview-gate');
    const snippetEl = document.getElementById('preview-snippet');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const stackId = tab.getAttribute('data-stack-id');
        const stack = stacksData.find((s) => s.id === stackId);
        if (!stack) return;

        // Active state styling
        tabs.forEach((t) => {
          t.className = 'polyglot-tab p-3 rounded-xl border text-left transition-all duration-150 cursor-pointer focus:outline-none flex items-center justify-between gap-2 group bg-white/60 border-slate-200/80 hover:bg-white hover:border-slate-300';
        });
        tab.className = 'polyglot-tab p-3 rounded-xl border text-left transition-all duration-150 cursor-pointer focus:outline-none flex items-center justify-between gap-2 group active bg-white border-emerald-500/80 shadow-xs ring-1 ring-emerald-500/20';

        // Update preview content
        if (filenameEl) filenameEl.textContent = `.clckernel.yaml — ${stack.id}`;
        if (detectionEl) detectionEl.textContent = stack.detection;
        if (runnerEl) runnerEl.textContent = stack.runner;
        if (gateEl) gateEl.textContent = stack.gate;
        if (snippetEl) {
          snippetEl.textContent = stack.snippet;
          if (typeof gsap !== 'undefined') {
            gsap.fromTo(snippetEl, { opacity: 0.6, y: 3 }, { opacity: 1, y: 0, duration: 0.2, ease: 'power2.out' });
          }
        }
      });
    });
  });
</script>
