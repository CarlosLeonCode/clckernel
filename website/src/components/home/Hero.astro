---
import { ui, localePath } from '../../i18n/ui.js';
import CommandCopy from '../CommandCopy.astro';
import { storyScenes } from './story-scenes';
import { NODES } from '../../scripts/story-layout.js';

interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const t = ui[lang];
const reasons = t['hero.reasons'].split('|');
const stationLabels = t['story.labels'].split('|');
const { overview, panels } = storyScenes(stationLabels, reasons[0], t['hero.approve']);
const chapters = [1, 2, 3, 4].map((n) => ({
  n,
  cap: t[`story.${n}.cap`],
  title: t[`story.${n}.title`],
  text: t[`story.${n}.text`],
}));
const chapterCaptions = chapters.map((c) => `${c.cap} · ${c.title}`).join('|');
---

<!--
  Hero + story: one section. Once the WebGL scene is live it becomes a sticky,
  full-bleed background behind the hero text and the four chapters (the
  action sits on the right on wide screens; a band at the top on phones);
  home.js maps the chapter in view to a camera shot. Without WebGL, with
  reduced motion or with Save-Data, the figure shows a static overview and
  every chapter shows its own static panel.
-->
<section class="band-ink story" id="hero" data-story aria-labelledby="hero-title">
  <figure
    class="story__bg gate"
    data-gate
    data-reasons={t['hero.reasons']}
    data-passed={t['hero.passedMsg']}
    data-stopped={t['hero.stoppedMsg']}
    data-approved={t['hero.approvedMsg']}
    data-waiting={t['hero.waitingMsg']}
    data-stage-label={t['hero.stage']}
    data-chapters={chapterCaptions}
    aria-labelledby="gate-caption"
  >
    <div class="gate__stage" data-gate-stage>
      <svg class="gate__fallback" viewBox={overview.viewBox} preserveAspectRatio="xMidYMid meet" role="img" aria-label={t['hero.figAlt']} set:html={overview.body} />
      <div class="gate__vignette" aria-hidden="true"></div>
      <div class="gate__hit" data-gate-hit></div>
      <div class="gate__overlay" aria-hidden="true">
        {NODES.map((n) => <span class="gate__label3d gate__label3d--node mono-label" data-node-label>{n.name}</span>)}
        {stationLabels.map((l) => <span class="gate__label3d mono-label" data-station-label>{l}</span>)}
        <span class="gate__tag mono-label"></span>
        <span class="gate__tag mono-label"></span>
        <span class="gate__tag mono-label"></span>
      </div>
      <div class="gate__approvals">
        {[0, 1, 2].map(() => (
          <button type="button" class="gate__approve mono-label" data-approve hidden aria-label={t['hero.approveLabel']}>{t['hero.approve']}</button>
        ))}
      </div>
    </div>

    <figcaption id="gate-caption" class="gate__caption mono-label">
      <span>{t['hero.fig']} · <span class="text-fog">{t['hero.sim']}</span></span>
      <span class="gate__chapter text-accent" aria-hidden="true" data-gate-chapter></span>
    </figcaption>

    <div class="gate__dock">
      <div class="gate__controls" data-gate-controls hidden>
        <div class="gate__toggle mono-label" role="group" aria-label={t['hero.send']}>
          <button type="button" class="gate__opt" data-kind="good" aria-label={t['hero.good']} aria-pressed="true">
            <span class="gate__swatch gate__swatch--good" aria-hidden="true"></span><span class="gate__long">{t['hero.good']}</span><span class="gate__short" aria-hidden="true">{t['hero.goodShort']}</span>
          </button>
          <button type="button" class="gate__opt" data-kind="risky" aria-label={t['hero.risky']} aria-pressed="false">
            <span class="gate__swatch gate__swatch--risky" aria-hidden="true"></span><span class="gate__long">{t['hero.risky']}</span><span class="gate__short" aria-hidden="true">{t['hero.riskyShort']}</span>
          </button>
          <button type="button" class="gate__opt" data-kind="approval" aria-label={t['hero.approval']} aria-pressed="false">
            <span class="gate__swatch gate__swatch--approval" aria-hidden="true"></span><span class="gate__long">{t['hero.approval']}</span><span class="gate__short" aria-hidden="true">{t['hero.approvalShort']}</span>
          </button>
        </div>
        <span class="mono-label gate__hint text-fog" aria-hidden="true">{t['hero.hint']}</span>
      </div>
      <span class="mono-label gate__counts tabular-nums" aria-hidden="true">
        <span class="gate__count"><span class="gate__dot" data-gate-dot></span><span>{t['hero.checked']} · <span data-readout="checked">003</span></span></span>
        <span class="gate__count"><span class="gate__dot gate__dot--stop" data-gate-dot-stop></span><span>{t['hero.stopped']} · <span data-readout="stopped">001</span></span></span>
        <span class="gate__count"><span class="gate__dot gate__dot--ok" data-gate-dot-ok></span><span>{t['hero.approved']} · <span data-readout="approved">000</span></span></span>
      </span>
    </div>
    <p class="sr-only" aria-live="polite" data-gate-live></p>
  </figure>

  <div class="story__intro">
    <a class="credit hero-credit" href="https://www.carlosleoncode.com" rel="author noopener" target="_blank">
      <img src="/images/brand/favicon-64.png" width="24" height="24" alt="" decoding="async" class="credit__mark" />
      <span class="credit__by mono-label">{t['hero.credit.by']}</span>
      <span class="credit__sep" aria-hidden="true"></span>
      <span class="credit__name">CarlosLeonCode</span>
      <svg class="credit__arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
      <span class="sr-only">{t['hero.credit.new']}</span>
    </a>
    <h1 id="hero-title" class="display text-[clamp(2.75rem,6.4vw,5.75rem)]">
      <span class="hero-line"><span>{t['hero.line1']}</span></span>
      <span class="hero-line text-accent"><span>{t['hero.line2']}</span></span>
    </h1>
    <p class="lede text-fog mt-8 hero-fade">{t['hero.sub']}</p>
    <div class="mt-10 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8 hero-fade">
      <CommandCopy lang={lang} />
      <a href={localePath(lang, '/how-it-works')} class="link-arrow text-paper">
        {t['hero.secondary']}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
    <p class="mono-label text-fog mt-5 normal-case tracking-normal hero-fade">{t['hero.cmdNote']}</p>
  </div>

  <ol class="story__chapters" aria-label={t['story.label']}>
    {chapters.map((c, i) => (
      <li class="chapter" data-chapter={c.n} aria-labelledby={`chapter-${c.n}`}>
        <div class="chapter__copy">
          <p class="mono-label text-accent">{c.cap}</p>
          <h2 id={`chapter-${c.n}`} class="chapter__title">{c.title}</h2>
          <p class="chapter__text text-fog">{c.text}</p>
        </div>
        <svg class="chapter__panel" viewBox={panels[i].viewBox} preserveAspectRatio="xMidYMid meet" role="img" aria-label={`${c.title}: ${c.text}`} set:html={panels[i].body} />
      </li>
    ))}
  </ol>
</section>

<style>
  .hero-line { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .hero-line > span { display: inline-block; }

  /* Entrance is armed only when JS runs and motion is allowed (see Layout). */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero-line > span { transform: translateY(105%); }
    :global(.js) .hero-fade { opacity: 0; }
    :global(.js) .hero-credit { opacity: 0; transform: translateY(10px); }
  }

  /* ---- Credit badge, the first thing above the headline ---- */
  /* Creator credit: a compact pill that sizes to its content in any layout
     (flex, grid or block parent). */
  .credit {
    display: inline-flex; align-items: center; gap: 0.6rem;
    width: fit-content; max-width: 100%;
    align-self: flex-start; justify-self: start;
    margin-bottom: 1.75rem;
    padding: 0.25rem 0.8rem 0.25rem 0.25rem;
    border: 1px solid rgb(242 239 232 / 0.14);
    border-radius: 999px;
    background: rgb(14 14 12 / 0.55);
    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    color: var(--color-paper);
    font-size: 0.875rem;
    line-height: 1;
    white-space: nowrap;
    transition: border-color 200ms var(--ease-out), background-color 200ms var(--ease-out);
  }
  .credit:hover { border-color: rgb(4 184 247 / 0.55); background: rgb(4 184 247 / 0.08); }
  .credit:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; border-radius: 999px; }
  .credit__mark {
    width: 24px; height: 24px; border-radius: 999px; flex: none;
    box-shadow: 0 0 0 1.5px rgb(4 184 247 / 0.7);
  }
  .credit__by { color: var(--color-fog); font-size: 0.6875rem; letter-spacing: 0.08em; }
  .credit__name { font-weight: 500; letter-spacing: -0.01em; }
  .credit__sep { width: 1px; height: 0.9rem; background: rgb(242 239 232 / 0.18); flex: none; }
  .credit__arrow { flex: none; color: var(--color-accent); transition: transform 200ms var(--ease-out); }
  .credit:hover .credit__arrow { transform: translate(2px, -2px); }

  /* ---- Layout: one grid; the figure becomes the sticky background ---- */
  .story {
    --gutter-x: var(--gutter);
    --stage-h: min(56svh, 30rem);
    position: relative;
    display: grid;
    grid-template-columns: [full-start] minmax(var(--gutter-x), 1fr) [content-start] minmax(0, 88rem) [content-end] minmax(var(--gutter-x), 1fr) [full-end];
    row-gap: 3rem;
    padding-bottom: 5rem;
  }
  .story__intro { grid-column: content; grid-row: 1; padding-top: 3.5rem; position: relative; z-index: 2; min-width: 0; }
  .story__chapters { grid-column: content; grid-row: 3; display: grid; gap: 3.5rem; position: relative; z-index: 2; }
  .story__bg { grid-column: content; grid-row: 2; }
  .chapter { display: grid; gap: 1.25rem; align-items: center; }
  .chapter__title { font-weight: 600; font-size: clamp(1.75rem, 3.4vw, 2.75rem); letter-spacing: -0.03em; line-height: 1.05; margin-top: 0.6rem; text-wrap: balance; }
  .chapter__text { margin-top: 0.9rem; font-size: clamp(1.0625rem, 1.3vw, 1.1875rem); line-height: 1.55; max-width: 34rem; text-wrap: pretty; }
  .chapter__panel { width: 100%; height: auto; max-height: 22rem; display: block; }

  @media (min-width: 1024px) {
    .story { padding-bottom: 6rem; }
    .story__intro { grid-row: 1; max-width: 46%; min-height: calc(100svh - 4rem); display: flex; flex-direction: column; justify-content: center; padding-block: 3rem; }
    .story__bg { grid-row: 1; justify-self: end; align-self: center; width: min(46%, 38rem); }
    .story__chapters { grid-row: 2; }
    .chapter { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 2rem; }
    .chapter__copy { grid-column: 1 / span 5; }
    .chapter__panel { grid-column: 6 / span 7; }
  }

  /* Live: full-bleed sticky background, copy floats on top. */
  :global(.story.is-live) .story__bg {
    grid-column: full; position: sticky; top: 4rem; z-index: 0; width: auto;
  }
  :global(.story.is-live) .story__intro,
  :global(.story.is-live) .story__chapters { pointer-events: none; }
  :global(.story.is-live) .story__intro > *,
  :global(.story.is-live) .chapter__copy { pointer-events: auto; }
  :global(.story.is-live) .chapter__panel { display: none; }
  /* Calm run-out after the last chapter: the scene fades here (home.js),
     still sticky, before the light section begins. */
  :global(.story.is-live) .story__chapters { padding-bottom: 30svh; }
  :global(.story.is-live) .story__bg { will-change: opacity; }
  :global(.story.is-live) .chapter__copy { opacity: 0.38; transition: opacity 500ms var(--ease-out); }
  :global(.story.is-live) .chapter.is-active .chapter__copy { opacity: 1; }
  @media (min-width: 1024px) {
    :global(.story.is-live) .story__bg { grid-row: 1 / span 2; align-self: start; justify-self: stretch; height: calc(100svh - 4rem); }
    :global(.story.is-live) .story__chapters { grid-row: 2; max-width: 36%; }
    :global(.story.is-live) .chapter { display: flex; align-items: center; min-height: 85svh; }
  }
  @media (max-width: 1023.98px) {
    /* The band sits above the chapter copy, which scrolls up beneath it and
       dissolves under its faded lower edge. */
    :global(.story.is-live) .story__bg {
      grid-row: 2 / span 2; align-self: start; height: var(--stage-h); z-index: 3;
      background: var(--color-ink);
      -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 91%, transparent 100%);
      mask-image: linear-gradient(180deg, #000 0%, #000 91%, transparent 100%);
    }
    :global(.story.is-live) .story__chapters { grid-row: 2 / span 2; padding-top: calc(var(--stage-h) + 1.5rem); }
    :global(.story.is-live) .chapter { min-height: 34svh; align-content: start; }
  }

  /* ---- The figure ---- */
  .gate { position: relative; margin: 0; aspect-ratio: 1 / 1; }
  :global(.story.is-live) .gate { aspect-ratio: auto; }
  .gate__stage { position: absolute; inset: 0; }
  .gate__fallback { width: 100%; height: 100%; display: block; transition: opacity 600ms var(--ease-out); }
  .gate__stage :global(canvas) {
    position: absolute; inset: 0; width: 100% !important; height: 100% !important;
    opacity: 0; transition: opacity 700ms var(--ease-out);
  }
  .gate.is-live .gate__stage :global(canvas) { opacity: 1; }
  .gate.is-live .gate__fallback { opacity: 0; }

  /* Edges dissolve into the page; on wide screens the left side darkens so
     the copy on top keeps its contrast. */
  .gate__vignette { position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 700ms var(--ease-out); }
  .gate.is-live .gate__vignette { opacity: 1; }
  .gate__vignette {
    background:
      linear-gradient(180deg, var(--color-ink) 0%, rgb(14 14 12 / 0) 14%, rgb(14 14 12 / 0) 80%, var(--color-ink) 100%),
      linear-gradient(90deg, var(--color-ink) 0%, rgb(14 14 12 / 0) 8%, rgb(14 14 12 / 0) 92%, var(--color-ink) 100%);
  }
  @media (min-width: 1024px) {
    .gate__vignette {
      background:
        linear-gradient(90deg, var(--color-ink) 0%, var(--color-ink) 27%, rgb(14 14 12 / 0.88) 36%, rgb(14 14 12 / 0) 50%),
        radial-gradient(120% 95% at 70% 52%, rgb(14 14 12 / 0) 55%, var(--color-ink) 100%),
        linear-gradient(180deg, var(--color-ink) 0%, rgb(14 14 12 / 0) 12%, rgb(14 14 12 / 0) 82%, var(--color-ink) 100%);
    }
  }

  .gate__hit { position: absolute; inset: 0; display: none; }
  .gate.is-live .gate__hit { display: block; cursor: pointer; touch-action: manipulation; }
  @media (min-width: 1024px) {
    .gate.is-live .gate__hit { left: 42%; }
  }
  .gate__hit:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -6px; border-radius: 8px; }

  /* Labels, reason tags and approve buttons positioned from the 3D scene. */
  .gate__overlay, .gate__approvals { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .gate__label3d, .gate__tag, .gate__approve { position: absolute; left: 0; top: 0; will-change: transform; white-space: nowrap; }
  .gate__label3d {
    font-size: 0.625rem; color: var(--color-fog); letter-spacing: 0.06em;
    opacity: 0; transition: opacity 250ms var(--ease-out);
  }
  .gate__label3d--node { color: var(--color-paper); text-transform: none; letter-spacing: 0.02em; }
  .gate__label3d:global(.is-on) { opacity: 1; }
  .gate__tag {
    padding: 0.2rem 0.45rem;
    font-size: 0.625rem; text-transform: none; letter-spacing: 0.02em;
    color: var(--color-amber); background: var(--color-ink);
    border: 1px solid var(--color-amber); border-radius: 3px;
    opacity: 0; transition: opacity 200ms var(--ease-out);
  }
  .gate__tag:global(.is-on) { opacity: 1; }
  .gate__approve {
    pointer-events: auto;
    min-height: 32px; padding: 0 0.8rem; border-radius: 999px;
    font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.04em;
    background: var(--color-accent); color: var(--color-ink);
    box-shadow: 0 0 0 4px rgb(4 184 247 / 0.18);
    cursor: pointer;
  }
  .gate__approve:hover { background: var(--color-accent-hi); }
  .gate__approve:focus-visible { outline: 2px solid var(--color-paper); outline-offset: 2px; }

  /* Floating UI: caption top-right, toggle and counters bottom-right. */
  .gate__caption {
    position: absolute; top: 1rem; right: max(var(--gutter), calc((100% - 88rem) / 2 + var(--gutter)));
    display: flex; flex-direction: column; align-items: flex-end; gap: 0.35rem;
    font-size: 0.6875rem; text-align: right; z-index: 2;
  }
  .gate__chapter { text-transform: none; letter-spacing: 0.02em; min-height: 1em; }
  .gate:not(.is-live) .gate__caption { position: static; align-items: flex-start; text-align: left; margin-top: 0.75rem; }
  .gate__dock {
    position: absolute; bottom: 1.25rem; right: max(var(--gutter), calc((100% - 88rem) / 2 + var(--gutter)));
    display: flex; flex-direction: column; align-items: flex-end; gap: 0.75rem; z-index: 2;
  }
  .gate:not(.is-live) .gate__dock { display: none; }
  .gate__controls { display: flex; flex-direction: column; align-items: flex-end; gap: 0.4rem; }
  .gate__toggle { display: inline-flex; flex-wrap: wrap; justify-content: flex-end; border-radius: 999px; background: rgb(14 14 12 / 0.72); box-shadow: inset 0 0 0 1px rgb(242 239 232 / 0.16); padding: 3px; }
  .gate__opt {
    display: inline-flex; align-items: center; gap: 0.5em;
    min-height: 36px; padding: 0 0.8rem; border-radius: 999px;
    font-size: 0.6875rem; color: var(--color-fog); cursor: pointer;
    transition: color 150ms var(--ease-out), background-color 150ms var(--ease-out);
  }
  .gate__opt:hover { color: var(--color-paper); }
  .gate__opt[aria-pressed='true'] { background: var(--color-ink-3); color: var(--color-paper); }
  .gate__opt:focus-visible { outline-offset: -2px; border-radius: 999px; }
  .gate__swatch { width: 8px; height: 8px; border-radius: 2px; display: inline-block; }
  .gate__swatch--good { background: var(--color-accent); }
  .gate__swatch--risky { background: var(--color-amber); }
  .gate__swatch--approval { background: transparent; border: 1.5px solid #bdf1fe; }
  .gate__hint { font-size: 0.625rem; text-transform: none; letter-spacing: 0.02em; }
  .gate__short { display: none; }
  /* Narrow screens keep the three options on one compact row. */
  @media (max-width: 560px) {
    .gate__toggle { flex-wrap: nowrap; }
    .gate__long { display: none; }
    .gate__short { display: inline; }
  }
  .gate__counts { display: flex; gap: 0.9em; font-size: 0.6875rem; white-space: nowrap; }
  .gate__count { display: inline-flex; align-items: center; gap: 0.45em; }
  .gate__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--color-accent); display: inline-block; }
  .gate__dot--stop { background: var(--color-amber); }
  .gate__dot--ok { background: transparent; border: 1.5px solid #bdf1fe; }

  @media (max-width: 1023.98px) {
    .gate__caption { top: 0.75rem; }
    .gate__dock { left: var(--gutter); right: var(--gutter); bottom: 2.6rem; align-items: center; gap: 0.45rem; }
    .gate__controls { align-items: center; }
    .gate__hint { display: none; }
  }
  @media (max-width: 420px) {
    .credit { font-size: 0.8125rem; gap: 0.5rem; padding-right: 0.7rem; }
    .credit__by { font-size: 0.6875rem; }
    .gate__caption, .gate__counts { font-size: 0.625rem; }
    .gate__counts { gap: 0.6em; }
    .gate__opt { padding: 0 0.5rem; font-size: 0.6rem; gap: 0.4em; min-height: 34px; }
    .gate__approve { min-height: 28px; padding: 0 0.6rem; font-size: 0.625rem; }
  }
</style>
