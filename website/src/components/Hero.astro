---
import { ui } from '../i18n/ui.js';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const t = ui[lang];
const isEs = lang === 'es';
---

<section class="relative min-h-[calc(100vh-4rem)] flex items-center py-8 lg:py-12 overflow-hidden" id="hero-section">
  <!-- Subtle ambient glow background that responds to mouse parallax -->
  <div id="hero-ambient-glow" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-[850px] h-[450px] bg-cyan-500/[0.04] blur-[150px] pointer-events-none -z-10 rounded-full transition-transform duration-700 ease-out"></div>
  <div class="absolute top-10 right-1/4 w-full max-w-[400px] h-[300px] bg-emerald-500/[0.03] blur-[120px] pointer-events-none -z-10 rounded-full"></div>

  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- LEFT COLUMN: Value Proposition & Universal Command -->
      <div class="lg:col-span-6 space-y-6 text-left relative" id="hero-left-col">
        <!-- Soft ambient aura to ensure 100% text contrast over WebGL background -->
        <div class="absolute -inset-8 bg-white/75 blur-2xl -z-10 rounded-3xl pointer-events-none"></div>
        
        <!-- Live status badge -->
        <div class="hero-anim-item inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-cyan-50 border border-cyan-200 text-cyan-900 text-xs font-semibold tracking-wide shadow-2xs cursor-default group transition-all duration-300 hover:border-cyan-300">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-600"></span>
          </span>
          <span>{t['hero.badge']}</span>
          <span class="text-cyan-400 font-mono">•</span>
          <span class="font-mono text-[11px] text-cyan-800 font-bold">v1.2</span>
        </div>

        <!-- Main Headline -->
        <h1 class="hero-anim-item text-4xl sm:text-5xl lg:text-[3.35rem] font-extrabold tracking-tight text-slate-900 leading-[1.08]">
          {isEs ? (
            <>
              Elimina el código descontrolado <span class="text-cyan-600">antes</span> de que llegue a producción.
            </>
          ) : (
            <>
              Eliminate uncontrolled code <span class="text-cyan-600">before</span> it reaches production.
            </>
          )}
        </h1>

        <!-- Subtitle -->
        <p class="hero-anim-item text-base sm:text-lg text-slate-600 leading-relaxed font-normal max-w-xl">
          {t['hero.description']}
        </p>

        <!-- Command Card & Quickstart (White Theme) -->
        <div id="hero-cmd-card" class="hero-anim-item p-4 rounded-2xl bg-white text-slate-900 shadow-xl shadow-slate-200/50 border border-slate-200 space-y-3 relative overflow-hidden transition-all duration-300 hover:border-cyan-300">
          <div class="flex items-center justify-between text-xs text-slate-500 font-mono pb-2 border-b border-slate-100">
            <span class="flex items-center gap-1.5 font-semibold text-slate-700">
              <span class="w-1.5 h-1.5 rounded-full bg-cyan-600 animate-pulse"></span>
              {t['hero.cmdCardTitle']}
            </span>
            <span class="text-cyan-700 font-bold px-2 py-0.5 rounded bg-cyan-50 border border-cyan-200/80 text-[10px]">{t['hero.cmdCardTag']}</span>
          </div>
          <div class="flex items-center justify-between gap-3 font-mono text-sm bg-slate-50 p-2.5 rounded-xl border border-slate-200/80">
            <div class="flex items-center gap-2 overflow-x-auto">
              <span class="text-cyan-600 select-none font-bold">$</span>
              <span class="text-slate-900 select-all font-semibold">npx clckernel start</span>
            </div>
            <button 
              id="hero-copy-btn"
              type="button"
              class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-xs font-sans font-medium text-white transition-all shrink-0 cursor-pointer shadow-xs active:scale-95"
              aria-label="Copy installation command"
            >
              <svg id="copy-icon-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span id="copy-btn-text">Copy</span>
            </button>
          </div>
        </div>

        <!-- Hero Action Links: GitHub + Carlos Leon Code -->
        <div class="hero-anim-item flex flex-wrap items-center gap-3 pt-1">
          <a
            href="https://github.com/carlosleoncode/clc_forge"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-xs transition-all cursor-pointer active:scale-95 group/gh"
          >
            <svg class="group-hover/gh:rotate-12 transition-transform duration-200" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span>{isEs ? "GitHub" : "GitHub"}</span>
          </a>

          <a
            href="https://www.carlosleoncode.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-800 text-xs font-semibold border border-slate-200 shadow-2xs transition-all cursor-pointer hover:border-cyan-400 group/clc"
          >
            <span class="w-2 h-2 rounded-full bg-cyan-500 animate-pulse"></span>
            <span>{isEs ? "Creado por Carlos León Code" : "By Carlos León Code"}</span>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover/clc:text-cyan-600 group-hover/clc:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>

        <!-- Pillar Highlights -->
        <div class="hero-anim-item grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
          <div class="pillar-item flex items-center gap-2 text-xs font-medium text-slate-700 p-1.5 rounded-lg transition-all duration-200 hover:bg-slate-100/80 cursor-default">
            <div class="w-6 h-6 rounded-md bg-cyan-50 border border-cyan-200 flex items-center justify-center shrink-0 shadow-2xs text-cyan-700">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <span class="font-bold text-slate-800">{t['hero.pillar1']}</span>
          </div>
          <div class="pillar-item flex items-center gap-2 text-xs font-medium text-slate-700 p-1.5 rounded-lg transition-all duration-200 hover:bg-slate-100/80 cursor-default">
            <div class="w-6 h-6 rounded-md bg-cyan-50 border border-cyan-200 flex items-center justify-center shrink-0 shadow-2xs text-cyan-700">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <span class="font-bold text-slate-800">{t['hero.pillar2']}</span>
          </div>
          <div class="pillar-item flex items-center gap-2 text-xs font-medium text-slate-700 p-1.5 rounded-lg transition-all duration-200 hover:bg-slate-100/80 cursor-default">
            <div class="w-6 h-6 rounded-md bg-cyan-50 border border-cyan-200 flex items-center justify-center shrink-0 shadow-2xs text-cyan-700">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <span class="font-bold text-slate-800">{t['hero.pillar3']}</span>
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN: Agentic AI Chat Interface (OpenCode / Cursor / Claude Code Style) -->
      <div class="lg:col-span-6" id="hero-right-col">
        <div class="chat-agent-window rounded-2xl overflow-hidden border border-slate-200 bg-white shadow-2xl shadow-slate-200/60 transition-all duration-300 flex flex-col justify-between min-h-[500px]" id="hero-chat-container">
          
          <!-- Chat Window Header (OpenCode / Agent Runner) -->
          <div class="bg-slate-50 px-4 py-3 border-b border-slate-200 flex items-center justify-between gap-3">
            <div class="flex items-center gap-2.5">
              <div class="flex items-center gap-1.5">
                <span class="w-3 h-3 rounded-full bg-[#ff5f56] shadow-2xs"></span>
                <span class="w-3 h-3 rounded-full bg-[#ffbd2e] shadow-2xs"></span>
                <span class="w-3 h-3 rounded-full bg-[#27c93f] shadow-2xs"></span>
              </div>
              
              <div class="h-4 w-px bg-slate-200 mx-0.5"></div>

              <div class="flex items-center gap-2">
                <div class="w-5 h-5 rounded-md bg-cyan-600 text-white flex items-center justify-center font-mono text-[10px] font-bold shadow-2xs">
                  ⚡
                </div>
                <div class="text-left">
                  <div class="text-xs font-bold text-slate-900 leading-none">OpenCode • Agent Workspace</div>
                  <div class="text-[10px] font-mono text-slate-500 font-medium">Harness: <span class="text-cyan-700 font-semibold" id="chat-harness-status">clckernel active</span></div>
                </div>
              </div>
            </div>

            <!-- Live Status & Pause indicator -->
            <div class="flex items-center gap-2">
              <div id="chat-status-badge" class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-cyan-50 border border-cyan-200 text-[10px] font-mono text-cyan-800 shadow-2xs font-semibold">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-600 animate-pulse" id="chat-status-dot"></span>
                <span id="chat-status-text">LIVE AGENT</span>
              </div>
            </div>
          </div>

          <!-- Phase Navigation Bar (6 AIUP Milestones: Setup + 5 Governed Phases) -->
          <div class="bg-slate-100/70 px-2 py-1.5 border-b border-slate-200 overflow-x-auto">
            <div class="flex items-center gap-1 text-[11px] font-mono min-w-max" id="chat-tabs-container">
              <button type="button" data-phase-idx="0" class="chat-tab flex items-center gap-1 py-1 px-2 rounded-lg text-cyan-900 font-bold bg-white border border-cyan-300 shadow-2xs transition-all cursor-pointer">
                <span>0. Setup</span>
              </button>
              <button type="button" data-phase-idx="1" class="chat-tab flex items-center gap-1 py-1 px-2 rounded-lg text-slate-600 font-medium hover:text-slate-900 hover:bg-white/60 transition-all cursor-pointer">
                <span>1. Rule #0</span>
              </button>
              <button type="button" data-phase-idx="2" class="chat-tab flex items-center gap-1 py-1 px-2 rounded-lg text-slate-600 font-medium hover:text-slate-900 hover:bg-white/60 transition-all cursor-pointer">
                <span>2. SDD</span>
              </button>
              <button type="button" data-phase-idx="3" class="chat-tab flex items-center gap-1 py-1 px-2 rounded-lg text-slate-600 font-medium hover:text-slate-900 hover:bg-white/60 transition-all cursor-pointer">
                <span>3. Red TDD</span>
              </button>
              <button type="button" data-phase-idx="4" class="chat-tab flex items-center gap-1 py-1 px-2 rounded-lg text-slate-600 font-medium hover:text-slate-900 hover:bg-white/60 transition-all cursor-pointer">
                <span>4. AST Gate</span>
              </button>
              <button type="button" data-phase-idx="5" class="chat-tab flex items-center gap-1 py-1 px-2 rounded-lg text-slate-600 font-medium hover:text-slate-900 hover:bg-white/60 transition-all cursor-pointer">
                <span>5. Sealed</span>
              </button>
            </div>
          </div>

          <!-- Chat Conversation Scroll Area -->
          <div class="p-4 sm:p-5 space-y-3.5 bg-white flex-1 overflow-y-auto font-sans text-xs min-h-[300px]" id="chat-stream-viewport">
            
            <!-- Dynamic Content Injected via Smooth GSAP Script -->
            <div id="chat-dynamic-content" class="space-y-3.5"></div>

          </div>

          <!-- Mock Chat Input Box (At Bottom) -->
          <div class="p-3 bg-slate-50 border-t border-slate-200 flex items-center gap-2">
            <div class="flex-1 bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-400 font-mono flex items-center justify-between shadow-2xs">
              <span class="truncate" id="chat-input-placeholder">{isEs ? "El arnés gobierna cada tool call del agente..." : "Harness governs every agent tool call..."}</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 font-bold border border-slate-200">AIUP</span>
            </div>
            <button type="button" class="w-8 h-8 rounded-xl bg-cyan-600 text-white flex items-center justify-center shadow-xs cursor-default">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<script is:inline>
  const isSpanish = document.documentElement.lang === 'es';

  const agentPhases = [
    {
      id: 'setup',
      title: isSpanish ? 'PASO 0: APROVISIONAMIENTO INICIAL' : 'STEP 0: INITIAL BOOTSTRAP',
      status: 'BOOTSTRAPPED',
      html: `
        <div class="space-y-3">
          <!-- Terminal Command Box -->
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-3 space-y-2 font-mono text-[11px] shadow-2xs">
            <div class="flex items-center justify-between text-slate-500 text-[10px] border-b border-slate-200 pb-1.5">
              <span class="font-bold flex items-center gap-1.5 text-slate-700">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-600"></span>
                <span>${isSpanish ? 'Terminal (Ejecución Única)' : 'Terminal (One-Time Setup)'}</span>
              </span>
              <span class="text-cyan-700 font-semibold">$ npx clckernel start</span>
            </div>
            <div class="text-slate-800 space-y-1 pt-0.5">
              <div class="text-emerald-700 font-semibold">✔ Stack detected: TypeScript + Next.js</div>
              <div class="text-slate-600">✔ Generated: <span class="text-slate-900 font-bold">AGENTS.md</span> (Single Source of Truth)</div>
              <div class="text-slate-600">✔ Dynamic Mirror: symlinked to <span class="text-indigo-700 font-bold">.cursorrules</span>, <span class="text-indigo-700 font-bold">CLAUDE.md</span>, <span class="text-indigo-700 font-bold">.antigravity</span></div>
              <div class="text-slate-600">✔ Pre-commit lock: installed to <span class="text-slate-900 font-bold">.husky/pre-commit</span></div>
            </div>
          </div>
          <div class="text-[11px] font-mono text-cyan-800 font-semibold bg-cyan-50 border border-cyan-200/80 p-2 rounded-lg flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-600 animate-pulse"></span>
            <span>${isSpanish ? '¡Listo! El resto ocurre dentro del chat con tu agente.' : 'Ready! Everything else happens inside your agent chat.'}</span>
          </div>
        </div>
      `
    },
    {
      id: 'rule0',
      title: isSpanish ? 'FASE 1: COMANDO UNIVERSAL Y REGLA #0' : 'PHASE 1: UNIVERSAL CMD & RULE #0',
      status: 'RULE #0 LOCK',
      html: `
        <div class="space-y-3">
          <!-- User Prompt -->
          <div class="flex items-start gap-2.5 justify-end">
            <div class="bg-cyan-50 border border-cyan-200 text-slate-800 p-2.5 rounded-2xl rounded-tr-xs max-w-[85%] shadow-2xs">
              <div class="text-[9px] font-bold text-cyan-900 font-mono mb-1 flex items-center justify-between gap-2">
                <span>Senior Engineer</span>
                <span class="bg-cyan-200/70 text-cyan-900 px-1.5 py-0.2 rounded text-[8px] font-mono font-bold tracking-wider">UNIVERSAL CMD</span>
              </div>
              <p class="text-xs text-slate-900 font-mono font-bold">clckernel feature auth-jwt</p>
              <p class="text-[11px] text-slate-600 font-sans mt-0.5">${isSpanish ? 'Implementa autenticación JWT con expiración de tokens.' : 'Implement JWT authentication with token expiration.'}</p>
            </div>
            <div class="w-6 h-6 rounded-full bg-slate-900 text-white flex items-center justify-center text-[10px] shrink-0 font-bold">👨‍💻</div>
          </div>
          <!-- Agent Response -->
          <div class="flex items-start gap-2.5">
            <div class="w-6 h-6 rounded-full bg-cyan-600 text-white flex items-center justify-center text-[10px] shrink-0 font-bold">🤖</div>
            <div class="bg-slate-50 border border-slate-200 p-3 rounded-2xl rounded-tl-xs w-full space-y-1.5 font-mono text-[11px] shadow-2xs">
              <div class="text-slate-500 italic text-[10px] font-sans">${isSpanish ? '🧠 Comando reconocido: clckernel feature auth-jwt. Activando máquina de estados AIUP.' : '🧠 Command recognized: clckernel feature auth-jwt. Activating AIUP state machine.'}</div>
              <div class="text-indigo-700 font-bold bg-indigo-50/90 px-2 py-1 rounded border border-indigo-200">⚡ State Machine: Phase 1 (Research) ➔ Phase 2 (Local SDD)</div>
              <div class="text-rose-700 font-semibold bg-rose-50 px-2 py-1 rounded border border-rose-200">${isSpanish ? '🛡️ Regla #0 activa: Prohibido editar código fuente sin sdds/auth-jwt/spec.md y aprobación HIT.' : '🛡️ Rule #0 active: Forbidden from editing source without sdds/auth-jwt/spec.md and HIT approval.'}</div>
            </div>
          </div>
        </div>
      `
    },
    {
      id: 'sdd',
      title: isSpanish ? 'FASE 2: PLANIFICACIÓN SDD LOCAL' : 'PHASE 2: LOCAL SDD PLANNING',
      status: 'SDD SPEC SEALED',
      html: `
        <div class="space-y-3">
          <div class="flex items-start gap-2.5">
            <div class="w-6 h-6 rounded-full bg-cyan-600 text-white flex items-center justify-center text-[10px] shrink-0 font-bold">🤖</div>
            <div class="bg-slate-50 border border-slate-200 p-3 rounded-2xl rounded-tl-xs w-full space-y-2 font-mono text-[11px] shadow-2xs">
              <div class="text-slate-500 italic text-[10px] font-sans">${isSpanish ? '🧠 Delimitando alcance arquitectónico y contratos antes de codificar.' : '🧠 Locking layer scope and contracts before writing implementation.'}</div>
              <div class="text-indigo-700 font-bold bg-indigo-50/90 px-2 py-1 rounded border border-indigo-200">⚡ Tool Call: write_file("sdds/auth-jwt/spec.md")</div>
              <div class="bg-white p-2 rounded border border-slate-200 space-y-1 text-slate-700 text-[10px]">
                <div>📁 <span class="font-bold">sdds/auth-jwt/</span> (100% Local &amp; Gitignored)</div>
                <div class="text-slate-500">• Domain Layer: <span class="text-slate-800 font-bold">src/domain/auth.ts</span> (Isolated)</div>
                <div class="text-slate-500">• Regression Test: <span class="text-slate-800 font-bold">test/auth.test.ts</span></div>
              </div>
              <div class="text-emerald-800 font-bold bg-emerald-50 px-2 py-1 rounded border border-emerald-200">✔ Scope autorizado por el Arquitecto (HIT Gate)</div>
            </div>
          </div>
        </div>
      `
    },
    {
      id: 'tdd',
      title: isSpanish ? 'FASE 3: TDD RED TRANSITION' : 'PHASE 3: RED TDD TRANSITION',
      status: 'DEFECT PROVEN (RED)',
      html: `
        <div class="space-y-3">
          <div class="flex items-start gap-2.5">
            <div class="w-6 h-6 rounded-full bg-cyan-600 text-white flex items-center justify-center text-[10px] shrink-0 font-bold">🤖</div>
            <div class="bg-slate-50 border border-slate-200 p-3 rounded-2xl rounded-tl-xs w-full space-y-2 font-mono text-[11px] shadow-2xs">
              <div class="text-slate-500 italic text-[10px] font-sans">${isSpanish ? '🧠 Escribiendo prueba de regresión para verificar el fallo antes del fix.' : '🧠 Writing regression test first to prove defect before implementing fix.'}</div>
              <div class="text-indigo-700 font-bold bg-indigo-50/90 px-2 py-1 rounded border border-indigo-200">⚡ Tool Call: run_command("pytest test/auth.test.ts")</div>
              <div class="bg-rose-50 border border-rose-200 p-2 rounded text-rose-800 space-y-1">
                <div class="font-bold flex items-center justify-between">
                  <span>🔴 FAIL: test_jwt_token_expiration()</span>
                  <span class="px-1.5 py-0.5 rounded bg-rose-100 text-[9px] font-bold border border-rose-300">EXIT: 1</span>
                </div>
                <div class="text-[10px] text-rose-700 font-sans">AssertionError: Expected expired status on invalid signature</div>
              </div>
              <div class="text-emerald-800 font-bold bg-emerald-50 px-2 py-1 rounded border border-emerald-200">✔ Fallo genuino capturado en log. Autorizado para fix.</div>
            </div>
          </div>
        </div>
      `
    },
    {
      id: 'ast',
      title: isSpanish ? 'FASE 4: AUDITORÍA AST NATIVA' : 'PHASE 4: NATIVE AST AUDIT',
      status: 'AST GUARDS PASSED',
      html: `
        <div class="space-y-3">
          <div class="flex items-start gap-2.5">
            <div class="w-6 h-6 rounded-full bg-cyan-600 text-white flex items-center justify-center text-[10px] shrink-0 font-bold">🤖</div>
            <div class="bg-slate-50 border border-slate-200 p-3 rounded-2xl rounded-tl-xs w-full space-y-2 font-mono text-[11px] shadow-2xs">
              <div class="text-slate-500 italic text-[10px] font-sans">${isSpanish ? '🧠 Ejecutando suite determinista de AST en Node.js y Python (<5ms).' : '🧠 Running deterministic native AST suite in Node.js & Python (<5ms).'}</div>
              <div class="text-indigo-700 font-bold bg-indigo-50/90 px-2 py-1 rounded border border-indigo-200">⚡ Tool Call: run_command("clckernel audit")</div>
              <div class="bg-emerald-50 border border-emerald-200 p-2 rounded text-emerald-900 space-y-1 text-[10px]">
                <div class="flex items-center justify-between font-semibold"><span>✔ scan_secrets: 0 hardcoded keys in diff</span><span class="text-emerald-700 font-bold">PASS</span></div>
                <div class="flex items-center justify-between font-semibold"><span>✔ check_architecture: Clean layer isolation</span><span class="text-emerald-700 font-bold">PASS</span></div>
                <div class="flex items-center justify-between font-semibold"><span>✔ check_db_efficiency: Zero N+1 ORM queries</span><span class="text-emerald-700 font-bold">PASS</span></div>
              </div>
              <div class="text-slate-500 text-[10px] font-medium">↳ Execution time: 2.8ms • Zero npm packages</div>
            </div>
          </div>
        </div>
      `
    },
    {
      id: 'sealed',
      title: isSpanish ? 'FASE 5: PRE-COMMIT Y SELLO' : 'PHASE 5: PRE-COMMIT GIT SEAL',
      status: 'AUTHORIZED & SEALED',
      html: `
        <div class="space-y-3">
          <div class="flex items-start gap-2.5">
            <div class="w-6 h-6 rounded-full bg-cyan-600 text-white flex items-center justify-center text-[10px] shrink-0 font-bold">🤖</div>
            <div class="bg-slate-50 border border-slate-200 p-3 rounded-2xl rounded-tl-xs w-full space-y-2 font-mono text-[11px] shadow-2xs">
              <div class="text-slate-500 italic text-[10px] font-sans">${isSpanish ? '🧠 Todas las salvaguardas validadas. Ejecutando commit determinista.' : '🧠 All safeguards verified. Authorizing deterministic git commit.'}</div>
              <div class="text-indigo-700 font-bold bg-indigo-50/90 px-2 py-1 rounded border border-indigo-200">⚡ Tool Call: run_command("clckernel commit 'feat(auth): jwt verified'")</div>
              <div class="bg-slate-900 text-white p-2.5 rounded-xl space-y-1 text-[10px]">
                <div class="text-emerald-400 font-bold">🚀 [clckernel] Pre-commit Hook: EXIT CODE 0</div>
                <div class="text-slate-300">✔ Clean Architecture • Real TDD • Zero Leaks</div>
              </div>
              <div class="text-emerald-800 font-bold bg-emerald-50 px-2 py-1 rounded border border-emerald-200">📦 Quality Harness Sealed: Clean PR ready for review</div>
            </div>
          </div>
        </div>
      `
    }
  ];

  let currentPhaseIdx = 0;
  let chatCycleTimer = null;
  let isChatPaused = false;

  function renderPhase(idx, animate = true) {
    const phase = agentPhases[idx];
    if (!phase) return;

    // Update Tabs Active State
    const tabs = document.querySelectorAll('.chat-tab');
    tabs.forEach((tab, i) => {
      if (i === idx) {
        tab.className = 'chat-tab flex items-center gap-1 py-1 px-2 rounded-lg text-cyan-900 font-bold bg-white border border-cyan-300 shadow-2xs transition-all cursor-pointer ring-1 ring-cyan-500/20';
      } else {
        tab.className = 'chat-tab flex items-center gap-1 py-1 px-2 rounded-lg text-slate-600 font-medium hover:text-slate-900 hover:bg-white/60 transition-all cursor-pointer';
      }
    });

    const contentContainer = document.getElementById('chat-dynamic-content');
    if (!contentContainer) return;

    contentContainer.innerHTML = phase.html;

    if (typeof gsap !== 'undefined' && animate) {
      gsap.killTweensOf(contentContainer);
      gsap.fromTo(contentContainer,
        { opacity: 0.4, y: 8, scale: 0.99 },
        { opacity: 1, y: 0, scale: 1, duration: 0.35, ease: 'power2.out', clearProps: 'transform' }
      );
    }
  }

  function startChatCycle() {
    clearInterval(chatCycleTimer);
    chatCycleTimer = setInterval(() => {
      if (!isChatPaused) {
        currentPhaseIdx = (currentPhaseIdx + 1) % agentPhases.length;
        renderPhase(currentPhaseIdx, true);
      }
    }, 4500);
  }

  document.addEventListener('DOMContentLoaded', () => {
    // Initial Render
    renderPhase(0, true);
    startChatCycle();

    // Tab Clicks
    const tabs = document.querySelectorAll('.chat-tab');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const idx = parseInt(tab.getAttribute('data-phase-idx') || '0', 10);
        currentPhaseIdx = idx;
        renderPhase(currentPhaseIdx, true);
        startChatCycle();
      });
    });

    // Pause on Hover
    const chatContainer = document.getElementById('hero-chat-container');
    if (chatContainer) {
      chatContainer.addEventListener('mouseenter', () => {
        isChatPaused = true;
        const statusText = document.getElementById('chat-status-text');
        const statusDot = document.getElementById('chat-status-dot');
        if (statusText) statusText.textContent = 'PAUSED';
        if (statusDot) statusDot.className = 'w-1.5 h-1.5 rounded-full bg-amber-500';
      });

      chatContainer.addEventListener('mouseleave', () => {
        isChatPaused = false;
        const statusText = document.getElementById('chat-status-text');
        const statusDot = document.getElementById('chat-status-dot');
        if (statusText) statusText.textContent = 'LIVE AGENT';
        if (statusDot) statusDot.className = 'w-1.5 h-1.5 rounded-full bg-cyan-600 animate-pulse';
      });

      // 3D Magnetic Parallax Tilt with GSAP
      chatContainer.addEventListener('mousemove', (e) => {
        if (typeof gsap === 'undefined') return;
        const rect = chatContainer.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;

        const rotX = -(y / rect.height) * 6;
        const rotY = (x / rect.width) * 6;

        gsap.to(chatContainer, {
          rotationX: rotX,
          rotationY: rotY,
          transformPerspective: 1200,
          duration: 0.25,
          ease: 'power1.out'
        });
      });

      chatContainer.addEventListener('mouseleave', () => {
        if (typeof gsap !== 'undefined') {
          gsap.to(chatContainer, {
            rotationX: 0,
            rotationY: 0,
            duration: 0.5,
            ease: 'power2.out'
          });
        }
      });
    }

    // Command Card Copy Button
    const heroCopyBtn = document.getElementById('hero-copy-btn');
    const heroCopyText = document.getElementById('copy-btn-text');
    if (heroCopyBtn && heroCopyText) {
      heroCopyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText('npx clckernel start');
        heroCopyText.textContent = 'Copied!';
        heroCopyBtn.classList.replace('bg-slate-900', 'bg-emerald-700');

        if (typeof gsap !== 'undefined') {
          gsap.fromTo(heroCopyBtn, 
            { scale: 0.9 }, 
            { scale: 1.05, duration: 0.2, yoyo: true, repeat: 1, ease: 'back.out(2)' }
          );
        }

        setTimeout(() => {
          heroCopyText.textContent = 'Copy';
          heroCopyBtn.classList.replace('bg-emerald-700', 'bg-slate-900');
        }, 2000);
      });
    }
  });
</script>
