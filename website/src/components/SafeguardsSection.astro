---
import { ui } from '../i18n/ui.js';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const t = ui[lang];
const isEs = lang === 'es';

const items = isEs ? [
  {
    id: "secrets",
    icon: "🛡️",
    title: "Anti-Fuga de Secretos",
    keyPoint: "Bloquea llaves de AWS/Stripe, JWTs y passwords en el diff con 0 falsos positivos.",
    tag: "scan_secrets (AST/Regex)",
    accent: "rose",
  },
  {
    id: "arch",
    icon: "🏛️",
    title: "Límites de Arquitectura",
    keyPoint: "Garantiza aislamiento estricto: Dominio → Casos de Uso → Infraestructura.",
    tag: "check_architecture (AST)",
    accent: "indigo",
  },
  {
    id: "perf",
    icon: "⚡",
    title: "Consultas N+1 en BD",
    keyPoint: "Detecta queries ORM dentro de bucles for/while en tiempo de análisis sintáctico.",
    tag: "check_db_efficiency (AST)",
    accent: "amber",
  },
  {
    id: "infra",
    icon: "📦",
    title: "Seguridad de Infraestructura",
    keyPoint: "Audita contenedores rootless, reversibilidad de migraciones y secrets en env.",
    tag: "docker_guard (Lint)",
    accent: "emerald",
  },
] : [
  {
    id: "secrets",
    icon: "🛡️",
    title: "Anti-Secret Leaks",
    keyPoint: "Blocks AWS/Stripe keys, JWT tokens, and DB passwords in diffs with 0 false positives.",
    tag: "scan_secrets (AST/Regex)",
    accent: "rose",
  },
  {
    id: "arch",
    icon: "🏛️",
    title: "Architecture Boundaries",
    keyPoint: "Enforces strict layer isolation: Domain → Use Cases → Infrastructure.",
    tag: "check_architecture (AST)",
    accent: "indigo",
  },
  {
    id: "perf",
    icon: "⚡",
    title: "N+1 Database Queries",
    keyPoint: "Flags ORM queries inside for/while loops at AST parse time.",
    tag: "check_db_efficiency (AST)",
    accent: "amber",
  },
  {
    id: "infra",
    icon: "📦",
    title: "Infrastructure Security",
    keyPoint: "Audits rootless containers, database migration reversibility, and env secrets.",
    tag: "docker_guard (Lint)",
    accent: "emerald",
  },
];
---

<section id="safeguards" class="relative py-20 md:py-28 border-t border-slate-200/80 bg-transparent overflow-hidden">
  
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Ultra clean & concise) -->
    <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-50 border border-cyan-200 text-cyan-800 text-xs font-mono font-medium shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span>
        <span>{t['safeguards.kicker']}</span>
      </div>
      
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight">
        {t['safeguards.title']}
      </h2>
      
      <p class="text-base text-slate-600 font-normal">
        {isEs ? "Análisis sintáctico ejecutado en el lenguaje nativo de tu repositorio (Ruby, Python, Go, Node, PHP). Cero dependencias foráneas, en < 5ms." : "Syntactic AST parsing executed in your repository's native runtime (Ruby, Python, Go, Node, PHP). Zero foreign dependencies, in < 5ms."}
      </p>
    </div>

    <!-- Organic Flow: Connected Pipeline Stream (No outer card box) -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 p-4 sm:p-5 rounded-2xl bg-slate-50 border border-slate-200/80 mb-10 shadow-xs" id="safeguards-flow-banner">
      
      <!-- Step 1: Input -->
      <div class="flex items-center gap-3 w-full md:w-auto px-3 py-2">
        <span class="text-2xl">📄</span>
        <div>
          <div class="text-[10px] font-mono uppercase text-slate-500 font-semibold">{isEs ? "Entrada" : "Input"}</div>
          <div class="text-xs font-bold text-slate-900">Staged Git Diff</div>
        </div>
      </div>

      <!-- Arrow / Connector 1 -->
      <div class="hidden md:flex items-center text-slate-300 font-mono text-sm select-none">
        ──────►
      </div>

      <!-- Step 2: Native AST Engine (Center Highlight) -->
      <div class="flex items-center gap-3 bg-white border border-cyan-300/80 px-4 py-2.5 rounded-xl w-full md:w-auto shadow-2xs ring-2 ring-cyan-500/10">
        <span class="w-2 h-2 rounded-full bg-cyan-600 animate-ping"></span>
        <div>
          <div class="text-[10px] font-mono uppercase text-cyan-800 font-bold">{isEs ? "Motor AST Nativo" : "Native AST Engine"}</div>
          <div class="text-xs font-bold text-slate-900">{isEs ? "0 Dependencias (< 5ms)" : "0 Dependencies (< 5ms)"}</div>
        </div>
      </div>

      <!-- Arrow / Connector 2 -->
      <div class="hidden md:flex items-center text-slate-300 font-mono text-sm select-none">
        ──────►
      </div>

      <!-- Step 3: Verified Gate -->
      <div class="flex items-center gap-3 w-full md:w-auto px-3 py-2">
        <span class="w-6 h-6 rounded-lg bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold text-xs shrink-0 shadow-2xs">✔</span>
        <div>
          <div class="text-[10px] font-mono uppercase text-emerald-800 font-semibold">{isEs ? "Resultado" : "Result"}</div>
          <div class="text-xs font-bold text-slate-900">{isEs ? "Código Verificado" : "100% Verified Code"}</div>
        </div>
      </div>

    </div>

    <!-- Borderless Feature Stream (Clean horizontal rows with dividers instead of cards) -->
    <div class="divide-y divide-slate-200 border-y border-slate-200" id="safeguards-list">
      {items.map((item) => (
        <div class="safeguard-row py-4 sm:py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-6 hover:bg-slate-50/70 transition-colors px-2 rounded-lg group">
          <div class="flex items-start sm:items-center gap-3.5 flex-1">
            <span class="text-xl p-2 rounded-xl bg-slate-100 text-slate-700 shrink-0 group-hover:scale-110 transition-transform shadow-2xs">
              {item.icon}
            </span>
            <div class="space-y-0.5">
              <h3 class="text-sm font-bold text-slate-900 group-hover:text-cyan-700 transition-colors">
                {item.title}
              </h3>
              <p class="text-xs text-slate-600 font-normal leading-relaxed">
                {item.keyPoint}
              </p>
            </div>
          </div>

          <span class="font-mono text-[11px] px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 font-semibold border border-slate-200/80 shrink-0 self-start sm:self-center shadow-2xs group-hover:border-cyan-200 group-hover:text-cyan-900 group-hover:bg-cyan-50 transition-colors">
            {item.tag}
          </span>
        </div>
      ))}
    </div>

  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const rows = document.querySelectorAll('.safeguard-row');
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      if (rows.length > 0) {
        gsap.fromTo(rows,
          { y: 15, opacity: 0.8 },
          {
            y: 0,
            opacity: 1,
            duration: 0.4,
            stagger: 0.06,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: '#safeguards-list',
              start: 'top 85%',
              toggleActions: 'play none none none'
            }
          }
        );
      }
    }
  });
</script>
