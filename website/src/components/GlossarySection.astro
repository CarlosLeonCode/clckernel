---
import { ui } from '../i18n/ui.js';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const t = ui[lang];
const isEs = lang === 'es';

const terms = isEs ? [
  {
    id: "term-ast",
    acronym: "AST",
    fullName: "Abstract Syntax Tree (Árbol de Sintaxis Abstracta)",
    category: "Parsing & Linters",
    definition: "Representación en árbol de la estructura sintáctica del código fuente. Permite inspeccionar imports, llamadas a funciones y consultas a base de datos en milisegundos (<5ms) de forma determinista, superando la fragilidad de expresiones regulares.",
    badge: "<5ms Engine"
  },
  {
    id: "term-dod",
    acronym: "DoD",
    fullName: "Definition of Done (Definición de Terminado)",
    category: "Calidad & Rigor",
    definition: "Criterio de aceptación estricto e inmutable que debe cumplirse antes de autorizar un commit o PR: tests unitarios en verde, 100% de compuertas AST aprobadas, capas aisladas y cero cambios fuera del alcance del SDD.",
    badge: "Quality Gate"
  },
  {
    id: "term-sdd",
    acronym: "SDD",
    fullName: "Spec-Driven Development (Diseño Previo)",
    category: "Metodología",
    definition: "Documento técnico local y gitignorado (sdds/) donde el agente redacta contratos de API, análisis de dependencias y planes de prueba antes de modificar cualquier archivo de código fuente.",
    badge: "100% Local"
  },
  {
    id: "term-tdd",
    acronym: "TDD",
    fullName: "Test-Driven Development (Red-to-Green)",
    category: "Verificación",
    definition: "Metodología donde se escribe primero una prueba de regresión que debe fallar demostrablemente en el log (Fase Roja) para comprobar el defecto antes de implementar la solución en código de producción (Fase Verde).",
    badge: "Red → Green"
  },
  {
    id: "term-ssot",
    acronym: "SSOT",
    fullName: "Single Source of Truth (Única Fuente de Verdad)",
    category: "Sincronización",
    definition: "Principio arquitectónico donde un único archivo central (AGENTS.md) define las leyes del repositorio y se sincroniza automáticamente con Cursor, Claude Code, Antigravity y Copilot sin duplicación manual.",
    badge: "Zero Drift"
  },
  {
    id: "term-aiup",
    acronym: "AIUP",
    fullName: "AI Unified Process (Proceso Unificado de IA)",
    category: "Gobernanza",
    definition: "Marco de trabajo disciplinado que estructura la interacción con agentes en 5 pilares deterministas: Investigación previa, SDD local, TDD Rojo a Verde, Salvaguardas AST y Bloqueo Pre-commit inmutable.",
    badge: "Methodology"
  },
  {
    id: "term-hit",
    acronym: "HIT Gate",
    fullName: "Human-In-The-Loop Gate (Compuerta Humana)",
    category: "Supervisión",
    definition: "Punto de control obligatorio donde el ingeniero revisa y aprueba explícitamente los escenarios de prueba y contratos definidos en el SDD antes de que el agente comience la fase de implementación.",
    badge: "Human Control"
  },
  {
    id: "term-n1",
    acronym: "N+1 Query",
    fullName: "Database Loop Anti-Pattern (Consulta N+1)",
    category: "Rendimiento",
    definition: "Antipatrón crítico donde se ejecutan consultas a la base de datos dentro de un bucle iterativo (for/while). El parser AST de CLC Kernel lo intercepta en milisegundos antes del commit.",
    badge: "AST Blocked"
  },
  {
    id: "term-agentos",
    acronym: "Agent-OS",
    fullName: "Agent Operating System & Domain Workflows",
    category: "Arquetipo",
    definition: "Arquetipo de gobernanza para repositorios basados en agentes autónomos, skills y playbooks de negocio. Aplica gobernanza Dual-Layer (desarrollo técnico + ejecución de dominio) e implementa salvaguardas para symlinks, compuertas HITL y esquemas de datos.",
    badge: "Dual-Layer"
  }
] : [
  {
    id: "term-ast",
    acronym: "AST",
    fullName: "Abstract Syntax Tree",
    category: "Parsing & Linters",
    definition: "Structural tree representation of source code. CLC Kernel inspects AST nodes natively (<5ms) to catch architecture violations, hardcoded secrets, and performance anti-patterns deterministically without regex flakiness.",
    badge: "<5ms Engine"
  },
  {
    id: "term-dod",
    acronym: "DoD",
    fullName: "Definition of Done",
    category: "Quality & Rigor",
    definition: "The strict completion checklist required before marking work as finished: tests passing in green, 100% AST audit score, clean layer boundaries, and zero unverified assumptions.",
    badge: "Quality Gate"
  },
  {
    id: "term-sdd",
    acronym: "SDD",
    fullName: "Spec-Driven Development",
    category: "Methodology",
    definition: "A local, gitignored specification (sdds/) where the AI agent outlines research findings, API contracts, and testing plans before touching any production source file.",
    badge: "100% Local"
  },
  {
    id: "term-tdd",
    acronym: "TDD",
    fullName: "Test-Driven Development (Red-to-Green)",
    category: "Verification",
    definition: "Development methodology where a failing regression test (Red Phase) must demonstrably fail first to prove the bug/feature requirement before implementing the solution (Green Phase).",
    badge: "Red → Green"
  },
  {
    id: "term-ssot",
    acronym: "SSOT",
    fullName: "Single Source of Truth",
    category: "Sync & Harness",
    definition: "Architecture where one single file (AGENTS.md) defines the repository laws, automatically mirrored to Cursor, Claude Code, Antigravity, and Copilot without manual drift.",
    badge: "Zero Drift"
  },
  {
    id: "term-aiup",
    acronym: "AIUP",
    fullName: "AI Unified Process",
    category: "Governance",
    definition: "The 5-stage deterministic engineering discipline implemented by CLC Kernel: Research → SDD Spec → TDD Red-to-Green → Native AST Safeguards → Immutable Pre-commit Lock.",
    badge: "Methodology"
  },
  {
    id: "term-hit",
    acronym: "HIT Gate",
    fullName: "Human-In-The-Loop Gate",
    category: "Supervision",
    definition: "A mandatory check where the engineer reviews and approves the agent's SDD specification and test scenarios before code execution begins.",
    badge: "Human Control"
  },
  {
    id: "term-n1",
    acronym: "N+1 Query",
    fullName: "Database Loop Anti-Pattern",
    category: "Performance",
    definition: "Performance anti-pattern where a database query is executed inside a loop (for/while). CLC Kernel's AST parser flags this immediately before commit.",
    badge: "AST Blocked"
  },
  {
    id: "term-agentos",
    acronym: "Agent-OS",
    fullName: "Agent Operating System & Domain Workflows",
    category: "Archetype",
    definition: "Governance archetype for repositories orchestrating autonomous agents, business playbooks, and specialized skills. Provides Dual-Layer governance (development runtime + domain execution) with guards for IDE symlinks, HITL contracts, and domain data integrity.",
    badge: "Dual-Layer"
  }
];
---

<section id="glossary" class="relative py-20 md:py-28 border-t border-slate-200/80 bg-transparent overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Clean & Direct) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="max-w-2xl space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-50 border border-cyan-200 text-cyan-800 text-xs font-mono font-medium shadow-2xs">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span>
          <span>{t['glossary.kicker']}</span>
        </div>
        
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-[1.12]">
          {t['glossary.title']}
        </h2>
        
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
          {t['glossary.desc']}
        </p>
      </div>

      <!-- Quick Action: Expand / Collapse All -->
      <button
        type="button"
        id="toggle-all-glossary-btn"
        class="self-start md:self-auto px-4 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 text-xs font-mono font-semibold border border-slate-200 shadow-2xs transition-all cursor-pointer flex items-center gap-2 shrink-0"
      >
        <span id="toggle-all-text">{isEs ? "Expandir todos" : "Expand all"}</span>
        <svg id="toggle-all-icon" class="w-3.5 h-3.5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
    </div>

    <!-- 2-Column Collapsible Accordion Grid (Zero Card Fatigue, High Density) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3 border-t border-slate-200 pt-6" id="glossary-accordion-root">
      {terms.map((item) => (
        <div class="glossary-item border-b border-slate-100 py-3 transition-colors" data-term-id={item.id}>
          
          <!-- Accordion Trigger Header (Collapsed by Default) -->
          <button
            type="button"
            class="glossary-toggle-btn w-full flex items-center justify-between text-left gap-3 py-1 cursor-pointer group focus:outline-none select-none"
            aria-expanded="false"
            aria-controls={`desc-${item.id}`}
            data-state="closed"
          >
            <div class="flex items-center gap-3 min-w-0">
              <span class="font-mono text-xs sm:text-sm font-extrabold px-2.5 py-1 rounded-lg bg-slate-900 text-white shadow-2xs shrink-0 group-hover:bg-cyan-600 transition-colors">
                {item.acronym}
              </span>
              <div class="truncate">
                <span class="text-sm font-bold text-slate-800 group-hover:text-cyan-700 transition-colors block truncate">
                  {item.fullName}
                </span>
                <span class="text-[10px] font-mono font-semibold text-slate-400 block truncate">
                  {item.category}
                </span>
              </div>
            </div>

            <div class="flex items-center gap-2 shrink-0">
              <span class="hidden sm:inline-block text-[10px] font-mono font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded border border-slate-200/80">
                {item.badge}
              </span>
              <span class="p-1 rounded-full text-slate-400 group-hover:text-slate-700 transition-transform duration-200 glossary-chevron">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </div>
          </button>

          <!-- Accordion Collapsible Panel -->
          <div
            id={`desc-${item.id}`}
            class="glossary-panel grid grid-rows-[0fr] opacity-0 transition-all duration-300 ease-out"
            data-state="closed"
            role="region"
          >
            <div class="overflow-hidden pt-2.5 pb-1">
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal pl-1 border-l-2 border-cyan-500/50">
                {item.definition}
              </p>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .glossary-panel[data-state="open"] {
    grid-template-rows: 1fr;
    opacity: 1;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.getElementById('glossary-accordion-root');
    const toggleAllBtn = document.getElementById('toggle-all-glossary-btn');
    const toggleAllText = document.getElementById('toggle-all-text');
    const toggleAllIcon = document.getElementById('toggle-all-icon');
    
    if (!root) return;

    const items = root.querySelectorAll('.glossary-item');
    let allExpanded = false;

    // Individual item toggle
    items.forEach((item) => {
      const btn = item.querySelector('.glossary-toggle-btn');
      const panel = item.querySelector('.glossary-panel');
      const chevron = item.querySelector('.glossary-chevron');

      if (btn && panel) {
        btn.addEventListener('click', () => {
          const isOpen = btn.getAttribute('data-state') === 'open';

          if (isOpen) {
            btn.setAttribute('data-state', 'closed');
            btn.setAttribute('aria-expanded', 'false');
            panel.setAttribute('data-state', 'closed');
            chevron?.classList.remove('rotate-180', 'text-cyan-600');
          } else {
            btn.setAttribute('data-state', 'open');
            btn.setAttribute('aria-expanded', 'true');
            panel.setAttribute('data-state', 'open');
            chevron?.classList.add('rotate-180', 'text-cyan-600');
          }
        });
      }
    });

    // Toggle all button
    if (toggleAllBtn) {
      toggleAllBtn.addEventListener('click', () => {
        allExpanded = !allExpanded;
        const isEs = document.documentElement.lang === 'es';

        items.forEach((item) => {
          const btn = item.querySelector('.glossary-toggle-btn');
          const panel = item.querySelector('.glossary-panel');
          const chevron = item.querySelector('.glossary-chevron');

          if (allExpanded) {
            btn?.setAttribute('data-state', 'open');
            btn?.setAttribute('aria-expanded', 'true');
            panel?.setAttribute('data-state', 'open');
            chevron?.classList.add('rotate-180', 'text-cyan-600');
          } else {
            btn?.setAttribute('data-state', 'closed');
            btn?.setAttribute('aria-expanded', 'false');
            panel?.setAttribute('data-state', 'closed');
            chevron?.classList.remove('rotate-180', 'text-cyan-600');
          }
        });

        if (toggleAllText) {
          if (allExpanded) {
            toggleAllText.textContent = isEs ? 'Contraer todos' : 'Collapse all';
            toggleAllIcon?.classList.add('rotate-180');
          } else {
            toggleAllText.textContent = isEs ? 'Expandir todos' : 'Expand all';
            toggleAllIcon?.classList.remove('rotate-180');
          }
        }
      });
    }

    // ScrollTrigger entrance animation
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      gsap.fromTo(root,
        { y: 20, opacity: 0.8 },
        {
          y: 0,
          opacity: 1,
          duration: 0.6,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: root,
            start: 'top 85%',
            toggleActions: 'play none none none'
          }
        }
      );
    }
  });
</script>
