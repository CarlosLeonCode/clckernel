---
import SectionHead from './tech/SectionHead.astro';
interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const isEs = lang === 'es';

// The session right after install (AGENTS.md "First session after install").
const firstSession = isEs
  ? 'Justo después de instalar, la primera sesión es de onboarding: el agente atiende primero tu pedido; si no hay pedido, explica qué se instaló y pregunta una vez si ejecutar clckernel start o mantener los valores por defecto. Cada tarea posterior sigue este ciclo.'
  : 'Right after install, the first session is onboarding: the agent puts your request first, otherwise explains what is installed and asks once whether to run clckernel start or keep the defaults. Every task after that follows this loop.';

const steps = isEs ? [
  { name: 'Investigación y causa raíz', summary: 'Inspecciona dependencias y trazas antes de tocar código, para entender las invariantes del dominio.', who: 'Agente', pills: ['Lectura previa', 'Traza del error'] },
  { name: 'Plan local SDD', summary: 'Escribe una especificación local y gitignorada (sdds/) con contratos, alcance y plan de pruebas antes de codificar.', who: 'Agente', pills: ['Local', 'Gitignorado'] },
  { name: 'Revisión humana', summary: 'Presenta la especificación y espera tu aprobación antes de implementar (Human-in-the-Loop).', who: 'Tú', pills: ['HITL'] },
  { name: 'Fase roja TDD', summary: 'Escribe primero el test que falla y registra el código de salida distinto de cero, para demostrar el defecto antes del cambio.', who: 'Agente', pills: ['Test primero', 'Exit code != 0'] },
  { name: 'Implementación', summary: 'Hace pasar los tests respetando la separación de capas (Dominio → Casos de uso → Infraestructura).', who: 'Agente', pills: ['Verde', 'Capas'] },
  { name: 'Auditoría y pre-commit', summary: 'Los guards se ejecutan con node tools/audit.js; en cada commit el hook los vuelve a ejecutar y cancela si algo falla.', who: 'Guards', pills: ['Hook nativo', 'CI como respaldo'] },
] : [
  { name: 'Research & root cause', summary: 'Inspects dependencies and tracebacks before touching code, to understand the domain invariants.', who: 'Agent', pills: ['Read first', 'Traceback'] },
  { name: 'Local SDD plan', summary: 'Writes a local, gitignored spec (sdds/) with contracts, scope and a test plan before coding.', who: 'Agent', pills: ['Local', 'Gitignored'] },
  { name: 'Human review', summary: 'Presents the spec and waits for your approval before implementing (Human-in-the-Loop).', who: 'You', pills: ['HITL'] },
  { name: 'TDD red phase', summary: 'Writes the failing test first and records the non-zero exit code, to prove the defect before the change.', who: 'Agent', pills: ['Test first', 'Exit code != 0'] },
  { name: 'Implementation', summary: 'Makes the tests pass while keeping the layers apart (Domain → Use cases → Infrastructure).', who: 'Agent', pills: ['Green', 'Layers'] },
  { name: 'Audit & pre-commit', summary: 'The guards run with node tools/audit.js; on every commit the hook runs them again and aborts when one fails.', who: 'Guards', pills: ['Native hook', 'CI backstop'] },
];
---

<section class="band-ink-2" aria-labelledby="loop-title" id="loop">
  <div class="wrap py-24 md:py-32">
    <SectionHead id="loop-title" surface="ink"
      title={isEs ? 'El ciclo que sigue el agente' : 'The loop the agent follows'}
      lede={isEs ? 'AGENTS.md describe seis pasos para cada tarea. Los cinco primeros los sigue el agente; el último lo comprueban los guards.' : 'AGENTS.md describes six steps for every task. The agent follows the first five; the guards check the last one.'} />
    <ol class="border-t rule-ink">
      {steps.map((s, i) => (
        <li class="grid gap-3 md:gap-6 md:grid-cols-12 py-7 border-b rule-ink items-baseline">
          <span class="md:col-span-1 mono-label text-fog">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="md:col-span-3 text-xl font-semibold tracking-[-0.02em]">{s.name}</h3>
          <p class="md:col-span-5 text-fog leading-relaxed">{s.summary}</p>
          <p class="md:col-span-3 mono-label flex flex-wrap gap-x-4 gap-y-1">
            <span class:list={[s.who === 'You' || s.who === 'Tú' ? 'text-accent' : 'text-paper']}>{s.who}</span>
            {s.pills.map((p) => <span class="text-fog">{p}</span>)}
          </p>
        </li>
      ))}
    </ol>
    <p class="mt-10 text-fog leading-relaxed max-w-[68ch]">{firstSession}</p>
  </div>
</section>
