---
import SectionHead from './tech/SectionHead.astro';
import CommandCopy from './CommandCopy.astro';
interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const isEs = lang === 'es';

// Real output of a Next.js install (README "What happens after install").
const install = `$ npx clckernel . --yes
  Detected: Next.js (App Router) · Vitest / Jest · Git hooks: githooks
  9 guard(s): scan_secrets, check_a11y, check_responsive, check_seo,
     check_ui_reuse, check_architecture, check_performance, verify_tdd, check_custom
  AGENTS.md, sdds/, docs/Journal/
  Git hook: active hook .githooks/pre-commit (node tools/audit.js --hook)
  Mirrors: CLAUDE.md, GEMINI.md, .cursorrules, .cursor/rules/clckernel_context.mdc,
     .github/copilot-instructions.md, .antigravity/rules.md -> AGENTS.md

Next steps
  1. Review and commit the harness: git add -A && git commit -m "chore: install clckernel"
     The pre-commit hook (.githooks/pre-commit) runs on this commit.
  2. Open your AI agent and ask it to run clckernel start to tailor the rules (.clckernel.yaml),
     or just start working: it follows AGENTS.md.
     AGENTS.md mirrors written for: Claude Code (CLAUDE.md), Gemini (GEMINI.md), Cursor, Copilot, Antigravity.
  3. Run npx clckernel audit anytime to see every guard's result.
  4. Project-specific checks go in tools/guards/ (the hook and the audit run them).
  5. Later, preview kernel updates with npx clckernel update --dry-run.`;

const commands = isEs ? [
  { cmd: 'npx clckernel', where: 'Terminal', desc: 'Instalación interactiva: muestra el stack detectado y pregunta antes de escribir. Añade --dry-run para ver solo el plan.' },
  { cmd: 'clckernel start', where: 'Agente', desc: 'Comando del agente (el CLI lo rechaza): analiza el código, propone el plan y escribe .clckernel.yaml solo para lo que quieras cambiar.' },
  { cmd: 'clckernel feature <name>', where: 'Agente', desc: 'Ciclo completo: investigación, spec en sdds/<name>/, revisión humana, test en rojo, implementación y auditoría.' },
  { cmd: 'clckernel fix <issue>', where: 'Agente', desc: 'Causa raíz sin editar, test de regresión que falla, cambio mínimo y auditoría.' },
  { cmd: 'npx clckernel audit', where: 'Terminal', desc: 'Ejecuta todos los guards y muestra el resumen por lentes. Con --change <name> escribe el informe y el recibo en sdds/<name>/.' },
  { cmd: 'npx clckernel doctor', where: 'Terminal', desc: 'Comprueba AGENTS.md, sdds/, tools/, el hook y que cada guard carga. No ejecuta los tests.' },
  { cmd: 'npx clckernel update --dry-run', where: 'Terminal', desc: 'Actualización no destructiva: refresca los archivos del kernel que puede demostrar intactos; los que editaste se conservan y la versión nueva queda al lado como .clckernel-new.' },
] : [
  { cmd: 'npx clckernel', where: 'Terminal', desc: 'Interactive install: shows the detected stack and asks before writing. Add --dry-run to print the plan only.' },
  { cmd: 'clckernel start', where: 'Agent', desc: 'Agent command (the CLI rejects it): scans the code, proposes the plan and writes .clckernel.yaml only for what you want to change.' },
  { cmd: 'clckernel feature <name>', where: 'Agent', desc: 'Full cycle: research, spec in sdds/<name>/, human review, red test, implementation and audit.' },
  { cmd: 'clckernel fix <issue>', where: 'Agent', desc: 'Root cause without edits, a failing regression test, a minimal change and the audit.' },
  { cmd: 'npx clckernel audit', where: 'Terminal', desc: 'Runs every guard and prints the per-lens summary. With --change <name> it writes the report and receipt to sdds/<name>/.' },
  { cmd: 'npx clckernel doctor', where: 'Terminal', desc: 'Checks AGENTS.md, sdds/, tools/, the hook and that every guard loads. It does not run the tests.' },
  { cmd: 'npx clckernel update --dry-run', where: 'Terminal', desc: 'Non-destructive update: refreshes the kernel files it can prove intact; files you edited are kept and the new version is written next to them as .clckernel-new.' },
];

const after = isEs ? {
  title: 'Después de instalar: la primera sesión con tu agente',
  desc: 'Mientras exista tools/.clckernel-managed.json y no exista .clckernel.yaml, se aplica la sección "First session after install" de AGENTS.md:',
  steps: [
    'Tu pedido va primero: el agente realiza la tarea bajo las reglas y menciona el onboarding una sola vez, al final.',
    'Si no hay pedido, explica brevemente qué se instaló y qué ejecuta el hook de pre-commit en cada commit.',
    'Hace UNA pregunta y espera: adaptar las reglas con clckernel start, o mantener los valores por defecto (esto escribe un .clckernel.yaml con solo un comentario, así la pregunta no se repite).',
  ],
  note: 'update solo reescribe las secciones de salvaguardas que no editaste de un AGENTS.md existente: los proyectos instalados antes de que existiera esta sección no la reciben.',
} : {
  title: 'After install: the first session with your agent',
  desc: 'While tools/.clckernel-managed.json exists and .clckernel.yaml does not, the "First session after install" section of AGENTS.md applies:',
  steps: [
    'Your request comes first: the agent does the task under the rules and mentions onboarding once, at the end.',
    'Otherwise it explains briefly what was installed and what the pre-commit hook runs on every commit.',
    'It asks ONE question and waits: tailor the rules with clckernel start, or keep the defaults (this writes a .clckernel.yaml that holds only a comment, so the question is not asked again).',
  ],
  note: 'update rewrites only the safeguard sections you did not edit in an existing AGENTS.md: projects installed before this section existed do not get it.',
};
---

<section class="band-ink" aria-labelledby="quickstart-title" id="quickstart">
  <div class="wrap py-24 md:py-32">
    <SectionHead id="quickstart-title" surface="ink"
      title={isEs ? 'Inicio rápido' : 'Quickstart'}
      lede={isEs ? 'Ejecuta el CLI en la raíz de tu proyecto. Termina con un bloque Next steps construido a partir de lo que instaló.' : 'Run the CLI in your project root. It ends with a Next steps block built from what it installed.'} />

    <CommandCopy lang={lang} />
    <figure class="mt-8">
      <pre class="code-block band-ink-2 border rule-ink rounded-[10px] p-5 text-paper"><code>{install}</code></pre>
      <figcaption class="mono-label text-fog mt-3">{isEs ? 'Salida para un proyecto Next.js en un repositorio git' : 'Output for a Next.js project in a git repository'}</figcaption>
    </figure>

    <h3 class="mt-20 text-2xl font-semibold tracking-[-0.02em] mb-6">{isEs ? 'Comandos' : 'Commands'}</h3>
    <ul class="border-t rule-ink">
      {commands.map((c) => (
        <li class="grid gap-2 md:gap-6 md:grid-cols-12 py-5 border-b rule-ink items-baseline">
          <code class="md:col-span-4 font-mono text-[0.875rem] text-accent break-words">{c.cmd}</code>
          <span class="md:col-span-1 mono-label text-fog">{c.where}</span>
          <p class="md:col-span-7 text-fog leading-relaxed">{c.desc}</p>
        </li>
      ))}
    </ul>

    <div class="mt-20 grid gap-6 md:grid-cols-12">
      <h3 class="md:col-span-4 text-2xl font-semibold tracking-[-0.02em]">{after.title}</h3>
      <div class="md:col-span-8 space-y-5">
        <p class="text-fog leading-relaxed">{after.desc}</p>
        <ol class="list-decimal pl-5 space-y-3 leading-relaxed marker:text-fog">
          {after.steps.map((s) => <li>{s}</li>)}
        </ol>
        <p class="text-fog text-sm">{after.note}</p>
      </div>
    </div>
  </div>
</section>
