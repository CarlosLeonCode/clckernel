const harnesses = [
  { name: 'Claude Code', file: 'CLAUDE.md' },
  { name: 'Gemini', file: 'GEMINI.md' },
  { name: 'Cursor', file: '.cursorrules · .cursor/rules/clckernel_context.mdc' },
  { name: 'GitHub Copilot', file: '.github/copilot-instructions.md' },
  { name: 'Google Antigravity', file: '.antigravity/rules.md' },
  { name: 'Windsurf', file: isEs ? '.windsurfrules (si está en mirrors.list)' : '.windsurfrules (when listed in mirrors.list)' },
