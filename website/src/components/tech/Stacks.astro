---

<section class="band-ink" aria-labelledby="stacks-title" id="stacks">
  <div class="wrap py-24 md:py-32">
    <SectionHead id="stacks-title" surface="ink"
      title={isEs ? 'Una misma ley para cada stack' : 'One law for every stack'}
      lede={isEs ? 'clckernel detecta el stack de tu repositorio, instala los guards que le corresponden y escribe el mismo AGENTS.md para todos tus asistentes.' : 'clckernel detects your repository\'s stack, installs the guards that fit it and writes the same AGENTS.md for all your assistants.'} />

    <div class="stacks" data-tabs>
      <div class="stacks__list" role="tablist" aria-label={isEs ? 'Stacks' : 'Stacks'}>
        {stacks.map((s, i) => (
          <button type="button" role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="stacks__tab">
            <span>{s.name}</span>
            <span class="mono-label text-fog">{s.lang}</span>
          </button>
        ))}
      </div>
      <div class="stacks__panels">
        {stacks.map((s, i) => (
          <div role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} data-tab-panel hidden={i !== 0} tabindex="0">
            <dl class="grid grid-cols-2 gap-x-6 gap-y-4 mb-6">
              <div><dt class="mono-label text-fog">{L.detection}</dt><dd class="font-mono text-sm mt-1 break-words">{s.detection}</dd></div>
              <div><dt class="mono-label text-fog">{L.runner}</dt><dd class="font-mono text-sm mt-1 break-words">{s.runner}</dd></div>
              <div><dt class="mono-label text-fog">{L.gate}</dt><dd class="font-mono text-sm mt-1 break-words">{s.gate}</dd></div>
              <div><dt class="mono-label text-fog">{L.rules}</dt><dd class="text-sm mt-1">{s.rules}</dd></div>
            </dl>
            <pre class="code-block band-ink-2 border rule-ink rounded-[10px] p-4 text-paper"><code>{s.snippet}</code></pre>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-20">
      <h3 class="text-2xl font-semibold tracking-[-0.02em] mb-6">{isEs ? 'Dónde lo lee cada asistente' : 'Where each assistant reads it'}</h3>
      <ul class="border-t rule-ink">
        {harnesses.map((h) => (
          <li class="grid sm:grid-cols-12 gap-1 sm:gap-6 py-4 border-b rule-ink">
            <span class="sm:col-span-4 font-medium">{h.name}</span>
            <code class="sm:col-span-8 font-mono text-sm text-fog break-words">{h.file}</code>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-fog max-w-[68ch]">{isEs ? 'Los mirrors son enlaces simbólicos a AGENTS.md. Un archivo propio con el mismo nombre que no sea un enlace (tu CLAUDE.md, por ejemplo) se conserva, y ese asistente lee tu archivo.' : 'The mirrors are symlinks to AGENTS.md. A file of your own with the same name that is not a symlink (your CLAUDE.md, for example) is kept, and that assistant reads your file instead.'}</p>
    </div>
  </div>
</section>

<style>
  .stacks { display: grid; gap: 2rem; }
  .stacks > * { min-width: 0; }
  @media (min-width: 1024px) { .stacks { grid-template-columns: 18rem 1fr; gap: 3rem; } }
  .stacks__list { display: flex; flex-direction: column; border-top: 1px solid rgb(242 239 232 / 0.14); }
  @media (max-width: 1023px) {
    .stacks__list { flex-direction: row; overflow-x: auto; border-top: 0; border-bottom: 1px solid rgb(242 239 232 / 0.14); scrollbar-width: thin; }
    .stacks__tab { flex: none; border-bottom: 0 !important; }
  }
  .stacks__tab {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    min-height: 48px; padding: 0.7rem 0.75rem; text-align: left; cursor: pointer;
    border-bottom: 1px solid rgb(242 239 232 / 0.14); color: var(--color-fog);
    transition: color 150ms var(--ease-out), background-color 150ms var(--ease-out);
  }
  .stacks__tab:hover { color: var(--color-paper); }
  .stacks__tab[aria-selected='true'] { color: var(--color-ink); background: var(--color-accent); }
  .stacks__tab[aria-selected='true'] .mono-label { color: var(--color-ink); }
  [data-tab-panel][hidden] { display: none; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') || '');
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const keys: Record<string, number> = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 };
        if (e.key in keys) { e.preventDefault(); select(tabs[(i + keys[e.key] + tabs.length) % tabs.length], true); }
        if (e.key === 'Home') { e.preventDefault(); select(tabs[0], true); }
        if (e.key === 'End') { e.preventDefault(); select(tabs[tabs.length - 1], true); }
      });
    });
  });
</script>
