---
import { ui } from '../i18n/ui.js';
import HarnessFileTree from './HarnessFileTree.astro';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const t = ui[lang];
const isEs = lang === 'es';

const pillars = isEs ? [
  {
    num: "01",
    tag: "Determinismo AST",
    title: "Prompts vs. AST",
    problem: "Las reglas en markdown (.cursorrules) se ignoran en contextos largos y queman miles de tokens.",
    solution: "Parsers AST locales (<5ms) que bloquean violaciones en el pre-commit de forma infalible.",
    icon: "shield"
  },
  {
    num: "02",
    tag: "Diseño Previo",
    title: "Inmediatez vs. SDD",
    problem: "Los agentes modifican código a ciegas sin entender invariantes de dominio ni arquitectura.",
    solution: "Especificación técnica local (SDD) obligatoria y aprobada antes de tocar una sola línea.",
    icon: "compass"
  },
  {
    num: "03",
    tag: "Rigor de Pruebas",
    title: "Tautología vs. TDD",
    problem: "Los LLMs inventan tests complacientes que pasan en falso sin verificar el defecto real.",
    solution: "TDD estricto donde la prueba de regresión DEBE fallar en rojo antes de aplicar el fix.",
    icon: "check-circle"
  }
] : [
  {
    num: "01",
    tag: "AST Determinism",
    title: "Prompts vs. AST",
    problem: "Markdown rules (.cursorrules) get ignored in large contexts and burn tokens on every turn.",
    solution: "Native local AST parsers (<5ms) that infallibly enforce architecture in pre-commit hooks.",
    icon: "shield"
  },
  {
    num: "02",
    tag: "Design First",
    title: "Immediacy vs. SDD",
    problem: "Agents write code blindly without understanding domain invariants or system architecture.",
    solution: "Mandatory local technical specification (SDD) reviewed before touching any source file.",
    icon: "compass"
  },
  {
    num: "03",
    tag: "Test Rigor",
    title: "Tautology vs. TDD",
    problem: "LLMs generate tautological tests that pass falsely without asserting actual defect regressions.",
    solution: "Strict TDD where the regression test MUST demonstrably fail in red before applying fixes.",
    icon: "check-circle"
  }
];
---

<section id="why" class="relative py-20 md:py-28 border-t border-slate-200/80 bg-transparent overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Clean & Direct) -->
    <div class="max-w-3xl mb-14 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-50 border border-cyan-200 text-cyan-800 text-xs font-mono font-medium shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span>
        <span>{t['why.kicker']}</span>
      </div>
      
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-[1.12]">
        {t['why.title']}
      </h2>
      
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
        {t['why.desc']}
      </p>
    </div>

    <!-- 3-Column High-Impact Architectural Contrasts (Zero Card-Fatigue, Borderless Grid) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10 mb-20" id="why-pillars-container">
      {pillars.map((pillar) => (
        <div class="group relative flex flex-col justify-between pt-6 border-t-2 border-slate-200 hover:border-cyan-500 transition-colors duration-300">
          
          <div class="space-y-4">
            <!-- Pillar Header -->
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-bold text-cyan-600 tracking-wider uppercase">
                {pillar.tag}
              </span>
              <span class="font-mono text-2xl font-extrabold text-slate-300 group-hover:text-cyan-600/40 transition-colors">
                {pillar.num}
              </span>
            </div>

            <!-- Title -->
            <h3 class="text-xl font-bold text-slate-900 tracking-tight">
              {pillar.title}
            </h3>

            <!-- Problem / Friction -->
            <div class="space-y-1.5 text-xs sm:text-sm text-slate-500 leading-relaxed">
              <div class="flex items-center gap-1.5 text-xs font-semibold text-rose-600">
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span>{isEs ? "El defecto común" : "The common flaw"}</span>
              </div>
              <p>{pillar.problem}</p>
            </div>
          </div>

          <!-- Solution / Determinism -->
          <div class="mt-6 pt-4 border-t border-slate-100 group-hover:border-cyan-100 transition-colors">
            <div class="space-y-1 text-xs sm:text-sm text-slate-800 leading-relaxed">
              <div class="flex items-center gap-1.5 text-xs font-bold text-cyan-700">
                <svg class="w-3.5 h-3.5 shrink-0 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>CLC Kernel</span>
              </div>
              <p class="font-medium text-slate-900">{pillar.solution}</p>
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- Interactive Modular Layers & File Tree Architecture (Clean & Open) -->
    <HarnessFileTree lang={lang} />

  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // ScrollTrigger entrance animation for why pillars
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      const pillarsContainer = document.getElementById('why-pillars-container');
      if (pillarsContainer) {
        gsap.fromTo(pillarsContainer,
          { y: 20, opacity: 0.8 },
          {
            y: 0,
            opacity: 1,
            duration: 0.6,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: pillarsContainer,
              start: 'top 85%',
              toggleActions: 'play none none none'
            }
          }
        );
      }
    }
  });
</script>

