---
interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const isEs = lang === 'es';

// File metadata and concise explanations for the Inspector
const fileData = {
  'agents_md': {
    path: 'AGENTS.md',
    badge: 'SSOT',
    type: 'Markdown • AI Law',
    desc: isEs 
      ? 'Gobierna el comportamiento del agente mediante la Regla #0 y la Interfaz Universal de Comandos (clckernel feature, fix, test, audit, doctor, commit). Se sincroniza automáticamente con Cursor, Claude Code, Copilot y Antigravity.'
      : 'Enforces Rule #0 and the Universal Command Interface (clckernel feature, fix, test, audit, doctor, commit). Automatically symlinks across Cursor, Claude Code, Copilot, and Antigravity.',
    codeTitle: 'AGENTS.md',
    codeLang: 'markdown',
    code: `# CLC Kernel — AI AGENTS LAW (SSOT)
> RULE #0: MANDATORY EXECUTION OVERRIDE
> Prohibits blind edits without Research, SDD, Red TDD, and Guard Audit.

## Universal Command Interface (All LLMs):
- clckernel feature <name>   -> Full AIUP cycle
- clckernel fix <issue>      -> Root cause -> Red TDD -> Clean fix
- clckernel test             -> Run test runner cleanly
- clckernel audit            -> Run guard audit gate
- clckernel doctor           -> Health diagnostic
- clckernel commit <message> -> Pre-flight audit & commit`
  },
  'clckernel_yaml': {
    path: '.clckernel.yaml',
    badge: 'CONFIG',
    type: 'YAML • Config',
    desc: isEs
      ? 'Configuración opcional: reglas regex propias (rules), rutas excluidas de los guards (exclude_paths), espejos de IDE, marcadores HITL, exclusiones de update, globs de TDD y severidad por guard. Los guards propios van en tools/guards/.'
      : 'Optional config: custom regex rules (rules), paths kept out of the guards (exclude_paths), IDE mirrors, HITL markers, update exclusions, TDD globs and per-guard severity. Project guards live in tools/guards/.',
    codeTitle: '.clckernel.yaml',
    codeLang: 'yaml',
    code: `# Optional: without this file every default applies.
rules:
  - name: no-console-log
    pattern: 'console\\.log\\('
    message: "Remove console.log before committing"
exclude_paths: ["vendor/**"]
severities:
  check_seo: warning`
  },
  'sdds_dir': {
    path: 'sdds/',
    badge: 'LOCAL',
    type: 'Directory • Local Specs',
    desc: isEs
      ? 'Directorio gitignorado donde el agente redacta especificaciones técnicas antes de codificar, evitando que actúe por inmediatez y manteniendo limpio el historial de git.'
      : 'Gitignored directory where agents draft technical specifications prior to modifying code, preventing impulsive edits and keeping git history clean.',
    codeTitle: '.gitignore',
    codeLang: 'gitignore',
    code: `# CLC Kernel Local Governance Specs
sdds/*
!sdds/.gitkeep`
  },
  'sdd_spec': {
    path: 'sdds/auth-jwt/spec.md',
    badge: 'SDD SPEC',
    type: 'Markdown • Contract',
    desc: isEs
      ? 'Fija el alcance exacto, contratos e invariantes antes de la implementación. El alcance es un protocolo que sigue el agente; ningún guard lo comprueba.'
      : 'Locks exact scope, API contracts, and domain invariants before implementation. Scope is a protocol the agent follows; no guard checks it.',
    codeTitle: 'sdds/auth-jwt/spec.md',
    codeLang: 'markdown',
    code: `# SDD: JWT Token Rotation
## 1. Scope
- Add expiration timestamp (15m) to auth payload.
- OUT OF SCOPE: Database schema migrations.

## 2. Invariants
- Invalid token signatures MUST return HTTP 401.
- Domain layer remains free of external JWT libraries.`
  },
  'tools_dir': {
    path: 'tools/',
    badge: 'GUARDS',
    type: 'Directory • Guard Scripts',
    desc: isEs
      ? 'Suite de guards locales en Node.js y Python: verificaciones basadas en patrones (regex) y, en stacks Python, análisis con Python AST. Validan arquitectura, dependencias y seguridad sin dependencias npm pesadas.'
      : 'Suite of local guards in pure Node.js and Python: pattern-based (regex) checks plus Python AST analysis on Python stacks. Validates architecture, boundaries, and security with zero npm bloat.',
    codeTitle: 'tools/ directory',
    codeLang: 'text',
    code: `tools/
├── audit.js                # Master orchestrator
├── check_architecture.js   # Layer boundaries (regex)
├── scan_secrets.js         # Diff credential scanner
├── check_db_efficiency.py  # N+1 heuristic (Python AST)
└── docker_guard.py         # Container security audit`
  },
  'tool_check_arch': {
    path: 'tools/check_architecture.js',
    badge: 'CLEAN ARCH',
    type: 'JavaScript • Pattern-based Guard',
    desc: isEs
      ? 'Guard basado en patrones (regex) que valida el aislamiento de capas en el diff: bloquea commits si la capa de Dominio importa frameworks externos o Infraestructura.'
      : 'Pattern-based (regex) guard enforcing layer isolation on staged diffs: blocks commits if Domain imports frameworks or Infrastructure.',
    codeTitle: 'tools/check_architecture.js',
    codeLang: 'javascript',
    code: `// Pattern-based check (regex over staged files)
const importsInfra = /from\\s+['"].*infrastructure/.test(sourceCode);
if (isDomainFile(filePath) && importsInfra) {
  console.error("Clean Architecture violation:");
  console.error("   Domain layer cannot import Infrastructure!");
  process.exit(1);
}`
  },
  'tool_scan_secrets': {
    path: 'tools/scan_secrets.js',
    badge: 'SECURITY',
    type: 'JavaScript • Security Guard',
    desc: isEs
      ? 'Escanea credenciales hardcodeadas (API keys, tokens JWT, private keys) en el diff antes del commit mediante patrones regex (pueden darse falsos positivos).'
      : 'Scans staged diffs for hardcoded API keys, JWT tokens, and credentials before commit using regex patterns (false positives are possible).',
    codeTitle: 'tools/scan_secrets.js',
    codeLang: 'javascript',
    code: `const diff = execSync('git diff --cached', { encoding: 'utf8' });
const leaks = detectCredentials(diff);
if (leaks.length > 0) {
  console.error("Secret leak blocked: hardcoded token detected");
  process.exit(1);
}`
  },
  'tool_db_efficiency': {
    path: 'tools/check_db_efficiency.py',
    badge: 'PERFORMANCE',
    type: 'Python • Performance Guard',
    desc: isEs
      ? 'Heurística N+1: analiza el AST de Python y marca llamadas tipo ORM dentro de bucles for/while.'
      : 'N+1 heuristic: parses Python AST and flags ORM-like calls inside for/while loops.',
    codeTitle: 'tools/check_db_efficiency.py',
    codeLang: 'python',
    code: `class QueryInLoopVisitor(ast.NodeVisitor):
    def visit_For(self, node):
        if has_orm_query_call(node):
            print("N+1 heuristic: ORM-like call inside loop")
            sys.exit(1)
        self.generic_visit(node)`
  },
  'tool_audit': {
    path: 'tools/audit.js',
    badge: 'ORCHESTRATOR',
    type: 'JavaScript • Master Gate',
    desc: isEs
      ? 'Orquestador maestro que ejecuta cada guard check_*/scan_* de tools/ y emite el resumen educativo al agente y al desarrollador.'
      : 'Master orchestrator running every check_*/scan_* guard in tools/ and emitting the educational summary to agent and developer.',
    codeTitle: 'tools/audit.js',
    codeLang: 'bash',
    code: `$ node tools/audit.js
  🛡️ SECURITY LENS:
     ✅ scan secrets: Passed
  🏛️ ARCHITECTURE LENS:
     ✅ check architecture: Passed
  ⚡ PERFORMANCE LENS:
     ✅ check db efficiency: Passed

Verdict: PASSED`
  },
  'precommit_hook': {
    path: '.githooks/pre-commit',
    badge: 'HOOK',
    type: 'Shell • Git Hook',
    desc: isEs
      ? 'Hook de git generado por el kernel. Llama a los orquestadores de auditoría con --hook (que ejecutan cada guard de tools/) y después a las herramientas externas del stack. Si algo falla, cancela el commit con Exit Code 1 (`--no-verify` lo omite; CI actúa como respaldo). Se instala en .githooks/ con core.hooksPath; solo va a .husky/pre-commit cuando Husky ya está activo.'
      : 'Git hook generated by the kernel. It calls the audit orchestrators with --hook (they run every guard in tools/) and then the stack\'s external tools. Anything failing aborts the commit with Exit Code 1 (`--no-verify` skips it; CI is the backstop). Installed in .githooks/ with core.hooksPath; it goes to .husky/pre-commit only when Husky is already active.',
    codeTitle: '.githooks/pre-commit',
    codeLang: 'bash',
    code: `#!/usr/bin/env bash
set -e
echo "Running CLC Kernel Next.js (App Router) Safeguards..."

# Guards: the audit orchestrators run every guard in tools/ once (kernel and project guards).
[ -f tools/audit.js ] || [ -f tools/audit.py ] || { echo "clckernel: no audit orchestrator in tools/" >&2; exit 1; }
if [ -f tools/audit.js ]; then node tools/audit.js --hook; fi
if [ -f tools/audit.py ]; then python3 tools/audit.py --hook; fi
if [ -x node_modules/.bin/tsc ] >/dev/null 2>&1; then npx tsc --noEmit; else echo "clckernel: tsc not available, skipped"; fi
if [ -x node_modules/.bin/lint-staged ] >/dev/null 2>&1; then npx lint-staged; else echo "clckernel: lint not available, skipped"; fi`
  },
  'domain_model': {
    path: 'src/domain/auth.ts',
    badge: 'PURE DOMAIN',
    type: 'TypeScript • Business Domain',
    desc: isEs
      ? 'Entidades y lógica de negocio puras, vigiladas por los guards de capas para detectar si el agente acopla lógica de dominio con librerías externas.'
      : 'Pure business domain entities, monitored by layer guards that flag when AI agents couple domain models with external libraries.',
    codeTitle: 'src/domain/auth.ts',
    codeLang: 'typescript',
    code: `// Pure Business Domain (Zero Framework Dependencies)
export interface UserSession {
  readonly userId: string;
  readonly expiresAt: number;
}

export function isSessionExpired(session: UserSession, now: number): boolean {
  return now >= session.expiresAt;
}`
  }
};

// Tree shown on the left: depth, label, the fileData entry it opens.
const tree = [
  { depth: 0, label: 'AGENTS.md', key: 'agents_md' },
  { depth: 0, label: '.clckernel.yaml', key: 'clckernel_yaml' },
  { depth: 0, label: 'sdds/', key: 'sdds_dir', folder: true },
  { depth: 1, label: 'auth-jwt/spec.md', key: 'sdd_spec' },
  { depth: 0, label: 'tools/', key: 'tools_dir', folder: true },
  { depth: 1, label: 'audit.js', key: 'tool_audit' },
  { depth: 1, label: 'check_architecture.js', key: 'tool_check_arch' },
  { depth: 1, label: 'scan_secrets.js', key: 'tool_scan_secrets' },
  { depth: 1, label: 'check_db_efficiency.py', key: 'tool_db_efficiency' },
  { depth: 0, label: '.githooks/', key: 'precommit_hook', folder: true },
  { depth: 1, label: 'pre-commit', key: 'precommit_hook' },
  { depth: 0, label: 'src/domain/', key: 'domain_model', folder: true },
  { depth: 1, label: 'auth.ts', key: 'domain_model' },
];
const keys = Object.keys(fileData) as (keyof typeof fileData)[];
---

<div class="hft" id="harness-file-tree" data-hft>
  <div class="hft__tree" role="group" aria-label={isEs ? 'Archivos del repositorio' : 'Repository files'}>
    <p class="mono-label text-stone mb-3">{isEs ? 'Raíz del repositorio' : 'Repository root'}</p>
    <ul class="space-y-0.5 font-mono text-[0.8125rem]">
      {tree.map((node, i) => (
        <li>
          <button
            type="button"
            class:list={['hft__node', { 'is-folder': node.folder }]}
            style={`--depth:${node.depth}`}
            data-file-key={node.key}
            aria-controls={`hft-panel-${node.key}`}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {node.folder
                ? <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                : <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5" />}
            </svg>
            <span class="truncate">{node.label}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <div class="hft__inspector" aria-live="polite">
    {keys.map((key, i) => {
      const f = fileData[key];
      return (
        <article class="hft__panel" id={`hft-panel-${key}`} data-panel={key} hidden={i !== 0}>
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h4 class="font-mono text-base font-medium break-all">{f.path}</h4>
            <span class="mono-label hft__badge">{f.badge}</span>
          </div>
          <p class="mono-label text-stone mt-2">{f.type}</p>
          <p class="mt-5 leading-relaxed text-ink/85 max-w-[62ch]">{f.desc}</p>
          <div class="mt-6 band-ink rounded-[10px] overflow-hidden">
            <p class="mono-label text-fog px-4 pt-3">{f.codeTitle}</p>
            <pre class="code-block px-4 pt-2 pb-4 text-paper"><code>{f.code}</code></pre>
          </div>
        </article>
      );
    })}
  </div>
</div>

<style>
  .hft { display: grid; gap: 2.5rem; }
  .hft > * { min-width: 0; }
  @media (min-width: 1024px) { .hft { grid-template-columns: minmax(16rem, 5fr) 7fr; gap: 4rem; } }
  .hft__node {
    display: flex; align-items: center; gap: 0.6rem; width: 100%;
    min-height: 40px; padding: 0.35rem 0.6rem 0.35rem calc(0.6rem + var(--depth) * 1.25rem);
    border-radius: 6px; text-align: left; color: var(--color-stone); cursor: pointer;
    transition: background-color 150ms var(--ease-out), color 150ms var(--ease-out);
  }
  .hft__node.is-folder { color: var(--color-ink); font-weight: 500; }
  .hft__node:hover { background: rgb(14 14 12 / 0.06); color: var(--color-ink); }
  .hft__node[aria-pressed='true'] { background: var(--color-ink); color: var(--color-paper); }
  .hft__badge { padding: 0.2rem 0.5rem; border-radius: 4px; background: var(--color-signal); color: var(--color-ink); }
  .hft__panel[hidden] { display: none; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-hft]').forEach((root) => {
    const nodes = root.querySelectorAll<HTMLButtonElement>('.hft__node');
    const panels = root.querySelectorAll<HTMLElement>('[data-panel]');
    nodes.forEach((node) => {
      node.addEventListener('click', () => {
        const key = node.dataset.fileKey;
        nodes.forEach((n) => n.setAttribute('aria-pressed', String(n === node)));
        panels.forEach((p) => { p.hidden = p.dataset.panel !== key; });
      });
    });
  });
</script>
