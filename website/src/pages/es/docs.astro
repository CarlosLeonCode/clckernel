---
import Layout from '../../layouts/Layout.astro';
import { ui } from '../../i18n/ui.js';

const lang = 'es';
const t = ui[lang];

const sections = [
  {
    id: "getting-started",
    title: "1. Primeros Pasos",
    icon: "🚀",
    items: [
      {
        id: "installation",
        title: "Instalación e Inicialización Inmediata",
        desc: "Aprovisiona un arnés completo de gobernanza en segundos, ahorrando semanas de configuración repetitiva y miles de tokens de contexto.",
        code: `$ npx clckernel start

# Escanea el proyecto, genera .clckernel.yaml, vincula reglas de IA e instala hooks de git.`,
      },
      {
        id: "doctor",
        title: "Diagnóstico de Salud (Doctor)",
        desc: "Valida los hooks de git pre-commit activos, los test runners y los parsers AST nativos sin dependencias.",
        code: `$ npx clckernel doctor

# Reporte de salud:
✔ Hook de git pre-commit activo (.husky/pre-commit)
✔ Test runner operativo (npm test / pytest)
✔ Motor AST nativo listo (Node.js & Python)
🟢 100% SALUDABLE: El sistema está totalmente gobernado.`,
      },
      {
        id: "rule-zero",
        title: "Regla #0: Intercepción Obligatoria de Ejecución",
        desc: "Ley inmutable del repositorio. Prohíbe a los agentes IA editar código fuente sin investigación previa, scope SDD y prueba de test que falle.",
        code: `# REGLA #0: INTERCEPCIÓN OBLIGATORIA DE EJECUCIÓN
Los agentes IA tienen ESTRICTAMENTE PROHIBIDO modificar código fuente sin:
1. Investigación y Causa Raíz
2. Delimitación de Scope SDD (sdds/{feature}/spec.md)
3. Fase Roja TDD Determinista (Exit code != 0)
4. Implementación Limpia de Arquitectura (Fase Verde)
5. Ejecución Obligatoria de la Compuerta AST (node tools/audit.js)`,
      },
      {
        id: "universal-commands",
        title: "Interfaz Universal de Comandos (Todos los LLMs)",
        desc: "Gramática determinista soportada por Claude Code, Cursor, Codeium/Windsurf, Copilot, Gemini y Antigravity a través de los enlaces espejo de AGENTS.md.",
        code: `# Gramática Universal de Comandos:
$ clckernel feature <nombre> -> Ciclo AIUP completo (Spec -> HIT -> TDD -> Implementación -> Auditoría)
$ clckernel fix <descrip>    -> Análisis de causa raíz -> Test de regresión -> Fix -> Auditoría
$ clckernel test             -> Ejecuta suite de pruebas en el runner nativo y valida salida limpia
$ clckernel audit            -> Ejecuta node tools/audit.js o audit.py y emite resumen
$ clckernel doctor           -> Verifica hooks de Git, symlinks de IDEs y motor AST
$ clckernel commit <mensaje> -> Auditoría pre-flight, verificación de scope SDD y commit convencional
$ clckernel guard create <n> -> Genera scaffold de linter AST nativo en tools/guards/
$ clckernel start            -> Detecta el stack y genera .clckernel.yaml`,
      }
    ]
  },
  {
    id: "default-safeguards",
    title: "2. Salvaguardas Nativas Adaptativas",
    icon: "🛡️",
    items: [
      {
        id: "core-safeguards",
        title: "Capas Adaptativas Out-of-the-Box",
        desc: "CLC Kernel aprovisiona salvaguardas que corren en el lenguaje nativo de tu repositorio (Ruby, Python, Go, Node, PHP) en < 5ms sin dependencias foráneas.",
        code: `// Catálogo de Salvaguardas Nativas:
1. scan_secrets         -> Bloquea claves de AWS/Stripe y JWTs (0 falsos positivos)
2. check_architecture   -> Aislamiento de capas Clean (Dominio -> Caso de Uso -> Infra)
3. check_db_efficiency  -> Detección de consultas ORM N+1 en bucles
4. check_responsive     -> Auditoría mobile-first CSS y áreas táctiles de 44x44px
5. check_seo            -> Valida Core Web Vitals y etiquetas OpenGraph
6. check_migrations     -> Idempotencia y reversibilidad en migraciones de BD
7. docker_guard         -> Exige contenedores rootless y bloquea secretos en ENV
8. check_scope          -> Bloquea cambios fuera del alcance del SDD local
9. check_symlinks       -> Valida symlinks de reglas para IDEs (CLAUDE.md, GEMINI.md, etc.)
10. check_hitl          -> Exige compuertas Human-in-the-Loop en playbooks autónomos
11. check_domain_data   -> Valida esquemas JSON y garantiza null por defecto ante métricas inventadas`,
      },
      {
        id: "ast-examples",
        title: "Micro-Diffs de Verificación AST",
        desc: "El análisis sintáctico elimina falsos positivos inspeccionando nodos del AST en el lenguaje nativo del proyecto en lugar de expresiones regulares frágiles.",
        code: `// Anti-Fuga de Secretos:
- const STRIPE_KEY = "sk_live_59182379123"; // ❌ BLOQUEADO
+ const STRIPE_KEY = process.env.STRIPE_KEY; // ✔ VALIDADO

// Límites de Clean Architecture:
- import { UserModel } from '../infra/db';   // ❌ BLOQUEADO en Vista
+ import { GetUserUseCase } from '../domain'; // ✔ VALIDADO`,
      }
    ]
  },
  {
    id: "custom-layers",
    title: "3. Personalización y Creación de Capas",
    icon: "⚙️",
    items: [
      {
        id: "config-yaml",
        title: "Configuración (.clckernel.yaml)",
        desc: "Activa, desactiva o ajusta umbrales para cualquier capa de salvaguarda en el manifiesto del repositorio.",
        code: `# .clckernel.yaml
version: "1.2"
framework: "rails" # o fastapi, django, nextjs, astro, golang, etc.
test_runner: "bundle exec rspec"

safeguards:
  scan_secrets: true
  check_architecture: true
  check_db_efficiency: true
  check_responsive: false # desactivar si es solo backend
  check_seo: false

# Scripts de salvaguarda personalizados (en el lenguaje nativo de tu stack):
custom_guards:
  - name: "check_naming_conventions"
    command: "ruby tools/guards/naming_guard.rb"`,
      },
      {
        id: "authoring-guards",
        title: "Creación de una Salvaguarda AST Propia",
        desc: "Crea scripts sencillos directamente en el lenguaje nativo de tu proyecto (Ruby, Python, Go, Node, PHP) sin requerir runtimes externos ni dependencias pesadas.",
        code: `// tools/guards/mi_guard_personalizado.js
import { execSync } from 'node:child_process';

const diff = execSync('git diff --cached', { encoding: 'utf-8' });

// Inspecciona el diff sintácticamente
if (diff.includes('apiInternaObsoleta()')) {
  console.error('❌ Violación: apiInternaObsoleta() está prohibida.');
  process.exit(1); // ¡Un código distinto de cero bloquea el commit de git!
}

console.log('✔ Salvaguarda personalizada aprobada.');
process.exit(0);`,
      }
    ]
  },
  {
    id: "ai-harnesses-sdd",
    title: "4. Arneses de IA y Protocolo SDD",
    icon: "🤖",
    items: [
      {
        id: "harness-sync",
        title: "Sincronización de Reglas para Agentes IA",
        desc: "Aprovisiona y vincula automáticamente reglas para los principales entornos de programación autónoma.",
        code: `• Cursor & Windsurf  -> .cursorrules y .cursor/rules/*.mdc
• Claude Code        -> CLAUDE.md (Comandos de terminal y límites TDD)
• Google Antigravity -> .antigravity/rules.md y skills nativos
• GitHub Copilot     -> .github/copilot-instructions.md`,
      },
      {
        id: "sdd-specs",
        title: "Flujo de Trabajo SDD Local (sdds/)",
        desc: "Los documentos de diseño de software viven 100% en local y están en el .gitignore para no ensuciar el historial de git.",
        code: `sdds/
  └── {nombre-del-cambio}/
      ├── spec.md        # Contratos de API y límites de capas
      ├── plan.md        # Plan paso a paso de TDD Rojo->Verde
      └── verification.md # Recibos de test y compuertas AST aprobadas`,
      }
    ]
  },
  {
    id: "agent-os-archetype",
    title: "5. Arquetipo Agent-OS y Flujos de Dominio",
    icon: "🧠",
    items: [
      {
        id: "dual-layer-governance",
        title: "Arquitectura de Gobernanza Dual-Layer",
        desc: "Para repositorios que orquestan agentes autónomos (como sistemas de marketing, ventas o bots operativos), CLC Kernel desacopla el arnés de ingeniería de desarrollo de las leyes de ejecución en tiempo de ejecución del dominio.",
        code: `# AGENTS.md (Estructura Dual-Layer)

# CAPA 1: ARNÉS DE DESARROLLO DEL REPOSITORIO (Meta-Reglas)
# Gobierna a los ingenieros y agentes que modifican el código fuente
- Regla #0: Investigación -> SDD -> TDD Rojo-Verde -> Auditoría AST
- Recibo de verificación obligatorio antes de cada commit

# CAPA 2: FLUJOS DE AGENTES DE DOMINIO (Leyes Operativas en Runtime)
# Gobierna a los agentes que ejecutan tareas de negocio y playbooks
- Compuertas Human-in-the-Loop (HITL) obligatorias antes de mutaciones externas
- Anti-Alucinación: Las métricas faltantes deben ser estrictamente null, nunca inventadas
- Voz de Marca inmutable y directrices de seguridad de contenido`,
      },
      {
        id: "domain-safeguards-spec",
        title: "Salvaguardas de Dominio (< 5ms)",
        desc: "Validadores especializados de cero dependencias que protegen la paridad de reglas en IDEs, compuertas de seguridad en playbooks y consistencia en esquemas de datos.",
        code: `// 1. check_symlinks: Valida symlinks de reglas para todos los IDEs
$ node tools/check_symlinks.js
✔ Los 5 archivos de reglas de IDE son symlinks válidos hacia AGENTS.md

// 2. check_hitl: Garantiza que los playbooks autónomos incluyan revisión humana
$ node tools/check_hitl.js
✔ Todas las skills definen puntos de control Human-in-the-Loop (HITL) explícitos

// 3. check_domain_data: Protege contra métricas alucinadas y esquemas rotos
$ node tools/check_domain_data.js
✔ Datasets JSON validados contra esquemas (0 claves faltantes, nulls limpios)`,
      }
    ]
  }
];

function generateMarkdown(secList: typeof sections) {
  let md = `# Documentación de CLC Kernel — Motor de Gobernanza Determinista para Agentes IA\n\n`;
  md += `> Aprovisionamiento inmediato de arneses de gobernanza, salvaguardas nativas AST (<5ms) y arquitectura Dual-Layer para proyectos de código y Agent-OS.\n\n`;

  secList.forEach((sec) => {
    md += `## ${sec.title}\n\n`;
    sec.items.forEach((item) => {
      md += `### ${item.title}\n\n${item.desc}\n\n\`\`\`\n${item.code}\n\`\`\`\n\n`;
    });
  });
  return md;
}

function generateLlmContext(secList: typeof sections) {
  const header = `<clckernel_knowledge_base>\n# ESPECIFICACIÓN AUTORITATIVA DE CLC KERNEL PARA AGENTES IA Y LLMS\n\nInstrucción para el modelo: Utiliza esta documentación oficial como fuente de verdad técnica para implementar o interactuar con proyectos gobernados por CLC Kernel.\n\n`;
  const body = generateMarkdown(secList);
  const footer = `\n</clckernel_knowledge_base>`;
  return header + body + footer;
}

const fullMarkdown = generateMarkdown(sections);
const fullLlmContext = generateLlmContext(sections);
---

<Layout lang="es" title="Documentación — CLC Kernel Gobernanza Determinista para IA">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    
    <!-- Docs Page Header -->
    <div class="mb-12 border-b border-slate-200 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-50 border border-cyan-200 text-cyan-800 text-xs font-mono font-semibold mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span>
        <span>DOCUMENTACIÓN OFICIAL</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight">
        Documentación de CLC Kernel
      </h1>
      <p class="text-base sm:text-lg text-slate-600 mt-2 max-w-3xl font-normal">
        Guía completa de arneses inmediatos, salvaguardas AST nativas y extensibilidad de capas a medida.
      </p>

      <!-- Quick Search Bar & Action Buttons -->
      <div class="mt-6 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <div class="relative flex-1 max-w-md">
          <input
            type="text"
            id="docs-search-input"
            placeholder="Buscar salvaguardas, reglas, capas personalizadas..."
            class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 text-xs font-mono focus:outline-none focus:border-cyan-500 focus:bg-white transition-all shadow-2xs"
          />
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btn-copy-markdown"
            class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 text-xs font-mono font-medium transition-colors shadow-2xs cursor-pointer min-h-[44px]"
            title="Copiar toda la documentación en formato Markdown"
          >
            <span>📋</span>
            <span class="btn-text">Copiar Markdown</span>
          </button>
          
          <button
            type="button"
            id="btn-copy-llm"
            class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2.5 rounded-xl border border-cyan-200 bg-cyan-50/80 hover:bg-cyan-100 text-cyan-900 text-xs font-mono font-bold transition-colors shadow-2xs cursor-pointer min-h-[44px]"
            title="Copiar contexto formateado para LLMs y Agentes IA"
          >
            <span>🤖</span>
            <span class="btn-text">Copiar para LLMs / Agentes</span>
          </button>
        </div>
      </div>
    </div>

    <!-- 2-Column Documentation Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Sticky Sidebar Navigation (Left Column) -->
      <aside class="lg:col-span-4 sticky top-24 space-y-6 bg-white p-5 rounded-2xl border border-slate-200 shadow-sm" id="docs-sidebar">
        <div class="text-xs font-mono uppercase text-slate-400 font-bold tracking-wider mb-2">
          Tabla de Contenidos
        </div>
        <nav class="space-y-4">
          {sections.map((sec) => (
            <div>
              <a href={`#${sec.id}`} class="flex items-center gap-2 text-xs font-bold text-slate-800 hover:text-cyan-700 transition-colors py-1">
                <span>{sec.icon}</span>
                <span>{sec.title}</span>
              </a>
              <ul class="pl-6 mt-1 space-y-1 border-l border-slate-100">
                {sec.items.map((item) => (
                  <li>
                    <a href={`#${item.id}`} class="doc-sublink block text-[11px] text-slate-500 hover:text-cyan-700 py-0.5 transition-colors truncate">
                      {item.title.split('—')[0]}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </aside>

      <!-- Documentation Articles (Right Column) -->
      <main class="lg:col-span-8 space-y-12" id="docs-content">
        <!-- Empty state when no matches -->
        <div id="docs-no-results" class="hidden p-10 text-center bg-slate-50 border border-slate-200 rounded-2xl space-y-3 font-mono">
          <div class="text-3xl">🔍</div>
          <div class="text-sm font-bold text-slate-800">No se encontraron artículos de documentación</div>
          <div class="text-xs text-slate-500">Prueba buscando términos como "ast", "secretos", "sdd", "tdd", "docker" o "hooks".</div>
        </div>

        {sections.map((sec) => (
          <section id={sec.id} class="doc-section space-y-8 scroll-mt-24">
            <div class="doc-section-header flex items-center gap-3 border-b border-slate-200 pb-3">
              <span class="text-2xl p-2 rounded-xl bg-slate-50 border border-slate-100">{sec.icon}</span>
              <h2 class="text-2xl font-extrabold text-slate-900">{sec.title}</h2>
            </div>

            <div class="space-y-6">
              {sec.items.map((item) => (
                <article id={item.id} class="doc-item bg-white p-6 rounded-2xl border border-slate-200 shadow-2xs space-y-3 scroll-mt-24">
                  <div class="flex items-start sm:items-center justify-between gap-3">
                    <h3 class="text-base font-bold text-slate-900">
                      {item.title}
                    </h3>
                    <button
                      type="button"
                      data-copy-title={item.title}
                      data-copy-desc={item.desc}
                      data-copy-code={item.code}
                      class="btn-copy-article inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-slate-200 bg-slate-50 hover:bg-white text-slate-600 hover:text-cyan-800 text-[11px] font-mono transition-colors shadow-2xs cursor-pointer shrink-0"
                      title="Copiar esta sección en Markdown"
                    >
                      <span>📋</span>
                      <span class="btn-text">Markdown</span>
                    </button>
                  </div>
                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                    {item.desc}
                  </p>

                  <div class="relative mt-3">
                    <pre class="bg-slate-50 text-slate-800 p-4 rounded-xl font-mono text-xs border border-slate-200/90 overflow-x-auto leading-relaxed shadow-inner"><code>{item.code}</code></pre>
                    <button
                      type="button"
                      onclick={`navigator.clipboard.writeText(\`${item.code}\`); const el=this; el.textContent='¡Copiado!'; setTimeout(()=>el.textContent='Copiar', 2000)`}
                      class="absolute top-2.5 right-2.5 px-2.5 py-1 rounded-md bg-white border border-slate-200 text-slate-600 hover:text-slate-900 text-[11px] font-sans font-medium transition-colors shadow-2xs cursor-pointer"
                    >
                      Copiar
                    </button>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </main>

    </div>

  </div>

  <!-- Payload oculto para copiado de documento completo -->
  <script type="application/json" id="docs-markdown-data" set:html={JSON.stringify({ markdown: fullMarkdown, llm: fullLlmContext })} />
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Helper de portapapeles con fallback
    async function copyToClipboard(text) {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
      } else {
        const textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.position = 'fixed';
        textArea.style.left = '-999999px';
        textArea.style.top = '-999999px';
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        document.execCommand('copy');
        textArea.remove();
      }
    }

    // Parseo de datos Markdown / LLM
    const docsDataEl = document.getElementById('docs-markdown-data');
    let docsData = { markdown: '', llm: '' };
    if (docsDataEl) {
      try {
        docsData = JSON.parse(docsDataEl.textContent || '{}');
      } catch (err) {
        console.error('Error al parsear datos de documentación', err);
      }
    }

    // Copiar documentación completa como Markdown
    const btnCopyMd = document.getElementById('btn-copy-markdown');
    if (btnCopyMd) {
      btnCopyMd.addEventListener('click', async () => {
        await copyToClipboard(docsData.markdown);
        const textSpan = btnCopyMd.querySelector('.btn-text');
        const origText = textSpan ? textSpan.textContent : '';
        if (textSpan) textSpan.textContent = '¡Markdown Copiado!';
        setTimeout(() => { if (textSpan) textSpan.textContent = origText; }, 2000);
      });
    }

    // Copiar documentación formateada para LLMs / Agentes
    const btnCopyLlm = document.getElementById('btn-copy-llm');
    if (btnCopyLlm) {
      btnCopyLlm.addEventListener('click', async () => {
        await copyToClipboard(docsData.llm);
        const textSpan = btnCopyLlm.querySelector('.btn-text');
        const origText = textSpan ? textSpan.textContent : '';
        if (textSpan) textSpan.textContent = '¡Copiado para LLMs!';
        setTimeout(() => { if (textSpan) textSpan.textContent = origText; }, 2000);
      });
    }

    // Copiado individual de artículo en Markdown
    const articleCopyBtns = document.querySelectorAll('.btn-copy-article');
    articleCopyBtns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const title = btn.getAttribute('data-copy-title') || '';
        const desc = btn.getAttribute('data-copy-desc') || '';
        const code = btn.getAttribute('data-copy-code') || '';
        const md = `### ${title}\n\n${desc}\n\n\`\`\`\n${code}\n\`\`\``;
        await copyToClipboard(md);
        const textSpan = btn.querySelector('.btn-text');
        const origText = textSpan ? textSpan.textContent : '';
        if (textSpan) textSpan.textContent = '¡Copiado!';
        setTimeout(() => { if (textSpan) textSpan.textContent = origText; }, 2000);
      });
    });

    // Lógica de filtrado de búsqueda
    const searchInput = document.getElementById('docs-search-input');
    const docSections = document.querySelectorAll('.doc-section');
    const noResults = document.getElementById('docs-no-results');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        let totalMatches = 0;

        docSections.forEach((section) => {
          const header = section.querySelector('.doc-section-header');
          const items = section.querySelectorAll('.doc-item');
          let sectionMatches = 0;

          items.forEach((item) => {
            const text = item.textContent.toLowerCase();
            if (!query || text.includes(query)) {
              item.style.display = 'block';
              sectionMatches++;
              totalMatches++;
            } else {
              item.style.display = 'none';
            }
          });

          // Si busca, ocultar header para ver solo resultados directos
          if (query) {
            if (sectionMatches > 0) {
              section.style.display = 'block';
              if (header) header.style.display = 'none';
            } else {
              section.style.display = 'none';
            }
          } else {
            // Restaurar vista al borrar búsqueda
            section.style.display = 'block';
            if (header) header.style.display = 'flex';
          }
        });

        if (noResults) {
          noResults.style.display = (query && totalMatches === 0) ? 'block' : 'none';
        }
      });
    }
  });
</script>
