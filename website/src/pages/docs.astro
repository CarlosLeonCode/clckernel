---
import Layout from '../layouts/Layout.astro';
import { ui } from '../i18n/ui.js';

const lang = 'en';
const t = ui[lang];

const sections = [
  {
    id: "getting-started",
    title: "1. Getting Started",
    icon: "🚀",
    items: [
      {
        id: "installation",
        title: "Installation & Instant Setup",
        desc: "Provisions a complete AI agent governance harness in seconds, saving weeks of repetitive configuration and thousands of context tokens.",
        code: `$ npx clckernel start

# Scans project signature, creates .clckernel.yaml, links AI rules, and installs git hooks.`,
      },
      {
        id: "doctor",
        title: "Health Diagnostic (Doctor)",
        desc: "Validates active git pre-commit hooks, test runners, and zero-dependency AST syntax parsers.",
        code: `$ npx clckernel doctor

# Output:
✔ Git pre-commit hook active (.husky/pre-commit)
✔ Test runner operational (npm test / pytest)
✔ AST audit engine ready (Node.js & Python native)
🟢 100% HEALTHY: System is fully governed.`,
      },
      {
        id: "rule-zero",
        title: "Rule #0: Mandatory Execution Override",
        desc: "Authoritative law in every governed codebase. Prohibits agents from editing source code without prior research, SDD scope lock, and failing test proofs.",
        code: `# RULE #0: MANDATORY EXECUTION OVERRIDE
AI agents are STRICTLY FORBIDDEN from modifying source code directly without:
1. Root Cause Research
2. Local SDD Scope Lock (sdds/{feature}/spec.md)
3. Deterministic Red TDD Phase (Exit code != 0)
4. Clean Architecture Implementation (Green Phase)
5. Mandatory AST Audit Gate (node tools/audit.js)`,
      }
    ]
  },
  {
    id: "default-safeguards",
    title: "2. Built-in Stack-Adaptive Safeguards",
    icon: "🛡️",
    items: [
      {
        id: "core-safeguards",
        title: "Adaptive Out-of-the-Box Layers",
        desc: "CLC Kernel automatically provisions safeguards in your project's native runtime (Ruby, Python, Go, Node, PHP) running in < 5ms with zero foreign dependencies.",
        code: `// Built-in Safeguards Catalog:
1. scan_secrets         -> Blocks AWS/Stripe keys & JWT tokens (0 false positives)
2. check_architecture   -> Enforces Clean Arch layer isolation (Domain -> Use Case -> Infra)
3. check_db_efficiency  -> Detects ORM queries inside loops (Zero N+1)
4. check_responsive     -> Audits mobile-first CSS & 44x44px touch targets
5. check_seo            -> Validates Core Web Vitals & OpenGraph tags
6. check_migrations     -> Verifies database migration idempotency & reversibility
7. docker_guard         -> Enforces rootless containers & blocks ENV secrets
8. check_scope          -> Blocks diffs modifying files outside local SDD scope`,
      },
      {
        id: "ast-examples",
        title: "Micro AST Diff Checks",
        desc: "Syntactic analysis eliminates false positives by checking AST node types in the repo's native language instead of fragile regex.",
        code: `// Secret Anti-Leak:
- const STRIPE_KEY = "sk_live_59182379123"; // ❌ BLOCKED
+ const STRIPE_KEY = process.env.STRIPE_KEY; // ✔ VALIDATED

// Clean Architecture Boundary:
- import { UserModel } from '../infra/db';   // ❌ BLOCKED in View
+ import { GetUserUseCase } from '../domain'; // ✔ VALIDATED`,
      }
    ]
  },
  {
    id: "custom-layers",
    title: "3. Customizing & Adding Layers",
    icon: "⚙️",
    items: [
      {
        id: "config-yaml",
        title: "Configuration (.clckernel.yaml)",
        desc: "Enable, disable, or adjust thresholds for any safeguard layer in your repository manifest.",
        code: `# .clckernel.yaml
version: "1.2"
framework: "rails" # or fastapi, django, nextjs, astro, golang, etc.
test_runner: "bundle exec rspec"

safeguards:
  scan_secrets: true
  check_architecture: true
  check_db_efficiency: true
  check_responsive: false # disable if backend-only
  check_seo: false

# Custom AST Guard scripts (written in your stack's native language):
custom_guards:
  - name: "check_naming_conventions"
    command: "ruby tools/guards/naming_guard.rb"`,
      },
      {
        id: "authoring-guards",
        title: "Authoring a Custom AST Guard",
        desc: "Create simple AST scripts directly in your project's native language (Ruby, Python, Go, Node, PHP) with zero foreign runtime bloat.",
        code: `// tools/guards/my_custom_guard.js
import { execSync } from 'node:child_process';

const diff = execSync('git diff --cached', { encoding: 'utf-8' });

// Inspect staged diff syntactically
if (diff.includes('deprecatedInternalApi()')) {
  console.error('❌ Violation: deprecatedInternalApi is forbidden.');
  process.exit(1); // Non-zero exit blocks the git commit!
}

console.log('✔ Custom naming guard passed.');
process.exit(0);`,
      }
    ]
  },
  {
    id: "ai-harnesses-sdd",
    title: "4. AI Harnesses & SDD Protocol",
    icon: "🤖",
    items: [
      {
        id: "harness-sync",
        title: "AI Agent Rules Synchronization",
        desc: "Automatically provisions and links rules for all major autonomous coding environments.",
        code: `• Cursor & Windsurf  -> .cursorrules & .cursor/rules/*.mdc
• Claude Code        -> CLAUDE.md (Terminal commands & TDD constraints)
• Google Antigravity -> .antigravity/rules.md & native skills
• GitHub Copilot     -> .github/copilot-instructions.md`,
      },
      {
        id: "sdd-specs",
        title: "Local SDD Workflow (sdds/)",
        desc: "Software Design Documents stay 100% local and gitignored, protecting repository history while isolating feature scopes.",
        code: `sdds/
  └── {change-name}/
      ├── spec.md        # API contracts & layer scope boundaries
      ├── plan.md        # Step-by-step Red->Green TDD implementation
      └── verification.md # Test receipts and AST audit pass proofs`,
      }
    ]
  }
];
---

<Layout lang="en" title="Documentation — CLC Kernel Deterministic AI Governance">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    
    <!-- Docs Page Header -->
    <div class="mb-12 border-b border-slate-200 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-50 border border-cyan-200 text-cyan-800 text-xs font-mono font-semibold mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span>
        <span>OFFICIAL DOCUMENTATION</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight">
        CLC Kernel Documentation
      </h1>
      <p class="text-base sm:text-lg text-slate-600 mt-2 max-w-3xl">
        Complete guide to instant harness setup, built-in AST safeguards, and modular custom layer extensibility.
      </p>

      <!-- Quick Search Bar -->
      <div class="mt-6 max-w-md relative">
        <input
          type="text"
          id="docs-search-input"
          placeholder="Search safeguards, rules, custom layers..."
          class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-900 text-xs font-mono focus:outline-none focus:border-cyan-500 focus:bg-white transition-all shadow-2xs"
        />
      </div>
    </div>

    <!-- 2-Column Documentation Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Sticky Sidebar Navigation (Left Column) -->
      <aside class="lg:col-span-4 sticky top-24 space-y-6 bg-white p-5 rounded-2xl border border-slate-200 shadow-sm" id="docs-sidebar">
        <div class="text-xs font-mono uppercase text-slate-400 font-bold tracking-wider mb-2">
          Table of Contents
        </div>
        <nav class="space-y-4">
          {sections.map((sec) => (
            <div>
              <a href={`#${sec.id}`} class="flex items-center gap-2 text-xs font-bold text-slate-800 hover:text-cyan-700 transition-colors py-1">
                <span>{sec.icon}</span>
                <span>{sec.title}</span>
              </a>
              <ul class="pl-6 mt-1 space-y-1 border-l border-slate-100">
                {sec.items.map((item) => (
                  <li>
                    <a href={`#${item.id}`} class="doc-sublink block text-[11px] text-slate-500 hover:text-cyan-700 py-0.5 transition-colors truncate">
                      {item.title.split('—')[0]}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </aside>

      <!-- Documentation Articles (Right Column) -->
      <main class="lg:col-span-8 space-y-12" id="docs-content">
        <!-- Empty state when no matches -->
        <div id="docs-no-results" class="hidden p-10 text-center bg-slate-50 border border-slate-200 rounded-2xl space-y-3 font-mono">
          <div class="text-3xl">🔍</div>
          <div class="text-sm font-bold text-slate-800">No documentation entries found</div>
          <div class="text-xs text-slate-500">Try searching for keywords like "ast", "secrets", "sdd", "tdd", "docker" or "hooks".</div>
        </div>

        {sections.map((sec) => (
          <section id={sec.id} class="doc-section space-y-8 scroll-mt-24">
            <div class="doc-section-header flex items-center gap-3 border-b border-slate-200 pb-3">
              <span class="text-2xl p-2 rounded-xl bg-slate-50 border border-slate-100">{sec.icon}</span>
              <h2 class="text-2xl font-extrabold text-slate-900">{sec.title}</h2>
            </div>

            <div class="space-y-6">
              {sec.items.map((item) => (
                <article id={item.id} class="doc-item bg-white p-6 rounded-2xl border border-slate-200 shadow-2xs space-y-3 scroll-mt-24">
                  <h3 class="text-base font-bold text-slate-900 flex items-center justify-between">
                    <span>{item.title}</span>
                  </h3>
                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                    {item.desc}
                  </p>

                  <div class="relative mt-3">
                    <pre class="bg-slate-50 text-slate-800 p-4 rounded-xl font-mono text-xs border border-slate-200/90 overflow-x-auto leading-relaxed shadow-inner"><code>{item.code}</code></pre>
                    <button
                      type="button"
                      onclick={`navigator.clipboard.writeText(\`${item.code}\`); const el=this; el.textContent='Copied!'; setTimeout(()=>el.textContent='Copy', 2000)`}
                      class="absolute top-2.5 right-2.5 px-2.5 py-1 rounded-md bg-white border border-slate-200 text-slate-600 hover:text-slate-900 text-[11px] font-sans font-medium transition-colors shadow-2xs cursor-pointer"
                    >
                      Copy
                    </button>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </main>

    </div>

  </div>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('docs-search-input');
    const docSections = document.querySelectorAll('.doc-section');
    const noResults = document.getElementById('docs-no-results');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        let totalMatches = 0;

        docSections.forEach((section) => {
          const header = section.querySelector('.doc-section-header');
          const items = section.querySelectorAll('.doc-item');
          let sectionMatches = 0;

          items.forEach((item) => {
            const text = item.textContent.toLowerCase();
            if (!query || text.includes(query)) {
              item.style.display = 'block';
              sectionMatches++;
              totalMatches++;
            } else {
              item.style.display = 'none';
            }
          });

          // If searching, hide section header so only direct matching items are shown
          if (query) {
            if (sectionMatches > 0) {
              section.style.display = 'block';
              if (header) header.style.display = 'none';
            } else {
              section.style.display = 'none';
            }
          } else {
            // Restore normal view when query is cleared
            section.style.display = 'block';
            if (header) header.style.display = 'flex';
          }
        });

        if (noResults) {
          noResults.style.display = (query && totalMatches === 0) ? 'block' : 'none';
        }
      });
    }
  });
</script>
